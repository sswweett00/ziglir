fn matrix_accum(n: i64) -> i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            let x: i64 = (i * 37 + j * 73) % 10007
            total = (total + x * (i + j)) % 1000000007
            j += 1
        }
        i += 1
    }
    return total
}

fn main() -> i64 {
    printInt(matrix_accum(3000))
    return 0
}
