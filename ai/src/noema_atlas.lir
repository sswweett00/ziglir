// noema_atlas.lir — NOEMA-Φ çok-kartlı topolojik atlas (Mimari §3.1).
//
// C >= 64 disk kartı, ikili hiyerarşik kavite ağacı üzerinde tutulur.
// Düğüm imzaları arena tablolarında (2C-1)*SIG_LEN f64 olarak yaşar:
// yapraklar 0..C-1 kart imzaları, iç düğümler C..2C-2 normalize
// edilmiş çocuk toplamlarıdır.
//
// Seçim: giriş kaba spektral özeti J_kaba ile |<J, Omega>|^2
// rezonansı hesaplanır; ağaç kökünden skor-sıralı greedy iniş yapılır
// (O(log C) beklenen; seçili yapraklar atlas_sel maskesiyle elenir).
//
// LIR çalışma zamanı kısıtı: struct'lar modül sınırını aşamaz ve
// &struct çağrıları güvenilmez olduğundan tüm NOEMA durumu arena
// bölgelerinde tutulur. Atlas denetim durumu:
//   atlas_i64: [0]=root [1]=next_id [2]=n_aktif [3..6]=slot_card[0..3]
//   atlas_f64: [0..31]=j_kaba [32..47]=kappa [48..63]=phi_ab
//              [64..67]=scores
// Demet köprüleri (kappa_ab, phi_ab) aktif slot çiftleri arasındadır.

import "noema_arena.lir"
import "noema_arena_rt.lir"

// atlas_i64 slotları
const AT_I_ROOT: i64 = 0
const AT_I_NEXT: i64 = 1
const AT_I_NAKTIF: i64 = 2
const AT_I_SLOT0: i64 = 3   // +k → slot_card[k]
// atlas_f64 slotları
const AT_F_JKABA: i64 = 0   // +j → j_kaba[j]   (32 eleman)
const AT_F_KAPPA: i64 = 32  // +i*4+j
const AT_F_PHI: i64 = 48    // +i*4+j
const AT_F_SCORES: i64 = 64 // +k
const AT_KOPRU_N: i64 = 16

// ── Arena yöntemleri: atlas iç hesapları ────────────────────────────────

impl Arena {
    /// Düğüm imza nokta çarpımı: <J_kaba, sig[node]>.
    fn atlas_dot(self: *Arena, node: i64) -> f64 {
        var sum = 0.0
        var j: i64 = 0
        while j < ARENA_SIG_LEN {
            sum = sum + self.atlas_f64_at(AT_F_JKABA + j) * self.cavity_node_at(node, j)
            j = j + 1
        }
        return sum
    }

    /// Rezonans enerjisi E_rez = |<J, Omega>|^2.
    fn atlas_score(self: *Arena, node: i64) -> f64 {
        let d = self.atlas_dot(node)
        return d * d
    }

    /// İmza vektörünün L2 normu.
    fn atlas_norm(self: *Arena, node: i64) -> f64 {
        var sum = 0.0
        var j: i64 = 0
        while j < ARENA_SIG_LEN {
            let v = self.cavity_node_at(node, j)
            sum = sum + v * v
            j = j + 1
        }
        return @sqrt(sum)
    }

    /// İç düğüm imzasını normalize(sol + sag) olarak yazar.
    fn atlas_aggregate(self: *Arena, node: i64) {
        let l = self.atlas_left_at(node)
        let r = self.atlas_right_at(node)
        var nrm = 0.0
        var j: i64 = 0
        while j < ARENA_SIG_LEN {
            let v = self.cavity_node_at(l, j) + self.cavity_node_at(r, j)
            self.cavity_node_set(node, j, v)
            nrm = nrm + v * v
            j = j + 1
        }
        let n = @sqrt(nrm)
        if n > 1e-12 {
            var k: i64 = 0
            while k < ARENA_SIG_LEN {
                self.cavity_node_set(node, k, self.cavity_node_at(node, k) / n)
                k = k + 1
            }
        }
    }

    /// Özyinelemeli ağaç kurucu: [lo,hi) yaprak aralığı için düğüm id.
    /// İç düğüm id'leri C'den başlar; kök en son atanır (2C-2).
    fn atlas_build_rec(self: *Arena, lo: i64, hi: i64) -> i64 {
        if hi - lo <= 1 {
            return lo
        }
        let mid = lo + (hi - lo) / 2
        let l = self.atlas_build_rec(lo, mid)
        let r = self.atlas_build_rec(mid, hi)
        let id = self.atlas_i64_at(AT_I_NEXT)
        self.atlas_i64_set(AT_I_NEXT, id + 1)
        self.atlas_left_set(id, l)
        self.atlas_right_set(id, r)
        self.atlas_aggregate(id)
        return id
    }

    /// Kökten yapraklara skor-sıralı greedy iniş.
    /// Seçili (atlas_sel != 0) yapraklar elenir; tükendiyse -1.
    fn atlas_descend(self: *Arena, node: i64) -> i64 {
        if node < self.cfg.c_total {
            if self.atlas_sel_get(node) == 0 {
                return node
            }
            return -1
        }
        let l = self.atlas_left_at(node)
        let r = self.atlas_right_at(node)
        let sl = self.atlas_score(l)
        let sr = self.atlas_score(r)
        if sl >= sr {
            let got = self.atlas_descend(l)
            if got >= 0 { return got }
            return self.atlas_descend(r)
        }
        let got = self.atlas_descend(r)
        if got >= 0 { return got }
        return self.atlas_descend(l)
    }

    // ── Genel atlas işlemleri ──────────────────────────────────────────

    /// İkili kavite ağacını kurar. Yaprak imzaları önceden
    /// cavity_sig_set ile yazılmış olmalıdır; iç düğümler agregatla dolar.
    /// C=1 köşe durumu: kök doğrudan tek yaprak olur.
    fn atlas_build(self: *Arena) {
        self.atlas_sel_clear()
        self.atlas_i64_set(AT_I_NEXT, self.cfg.c_total)
        self.atlas_i64_set(AT_I_ROOT, self.atlas_build_rec(0, self.cfg.c_total))
        self.atlas_i64_set(AT_I_NAKTIF, 0)
    }

    /// Giriş kaba özetinin j'inci bileşenini yazar.
    fn atlas_j_set(self: *Arena, j: i64, v: f64) {
        self.atlas_f64_set(AT_F_JKABA + j, v)
    }
    fn atlas_j_get(self: *Arena, j: i64) -> f64 {
        return self.atlas_f64_at(AT_F_JKABA + j)
    }

    /// Rezonansa göre en fazla k kart seçer (k <= NOEMA_K_AKTIF).
    /// Dönen: seçilen kart sayısı. atlas_sel[c]=slot+1,
    /// slot_card[slot]=c (atlas_i64 AT_I_SLOT0+k).
    fn atlas_select(self: *Arena, k: i64) -> i64 {
        self.atlas_sel_clear()
        var n: i64 = 0
        var g: i64 = 0
        while n < k and g < self.cfg.c_total {
            let leaf = self.atlas_descend(self.atlas_i64_at(AT_I_ROOT))
            if leaf < 0 { break }
            self.atlas_sel_set(leaf, n + 1)
            self.atlas_i64_set(AT_I_SLOT0 + n, leaf)
            self.atlas_f64_set(AT_F_SCORES + n, self.atlas_score(leaf))
            n = n + 1
            g = g + 1
        }
        self.atlas_i64_set(AT_I_NAKTIF, n)
        return n
    }

    /// Disk kartı c'nin aktif slot'u (0..K-1) veya -1.
    fn atlas_slot_of(self: *Arena, c: i64) -> i64 {
        return self.atlas_sel_get(c) - 1
    }

    /// Slot k'daki disk kartı.
    fn atlas_card_of(self: *Arena, k: i64) -> i64 {
        return self.atlas_i64_at(AT_I_SLOT0 + k)
    }

    /// Seçili aktif kart sayısı.
    fn atlas_n_aktif(self: *Arena) -> i64 {
        return self.atlas_i64_at(AT_I_NAKTIF)
    }

    // ── Demet köprüleri ─────────────────────────────────────────────────
    // Köprüler aktif slot çiftleri arasındadır; indeks (i*4+j).

    fn atlas_kappa_get(self: *Arena, i: i64, j: i64) -> f64 {
        return self.atlas_f64_at(AT_F_KAPPA + i * 4 + j)
    }
    fn atlas_phi_get(self: *Arena, i: i64, j: i64) -> f64 {
        return self.atlas_f64_at(AT_F_PHI + i * 4 + j)
    }

    /// Köprü kurma: kappa_ab >= 0, phi_ba = -phi_ab otomatik.
    /// (i,i) kendine köprü sıfırlanır.
    fn atlas_bridge_set(self: *Arena, i: i64, j: i64, kappa: f64, phi: f64) {
        if i == j {
            self.atlas_f64_set(AT_F_KAPPA + i * 4 + j, 0.0)
            self.atlas_f64_set(AT_F_PHI + i * 4 + j, 0.0)
            return
        }
        self.atlas_f64_set(AT_F_KAPPA + i * 4 + j, kappa)
        self.atlas_f64_set(AT_F_PHI + i * 4 + j, phi)
        self.atlas_f64_set(AT_F_KAPPA + j * 4 + i, kappa)
        self.atlas_f64_set(AT_F_PHI + j * 4 + i, 0.0 - phi)
    }

    /// Tüm köprüleri sıfırlar.
    fn atlas_bridges_clear(self: *Arena) {
        var i: i64 = 0
        while i < AT_KOPRU_N {
            self.atlas_f64_set(AT_F_KAPPA + i, 0.0)
            self.atlas_f64_set(AT_F_PHI + i, 0.0)
            i = i + 1
        }
    }
}
