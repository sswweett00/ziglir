// Akış hattı eğitim sürücüsü: stream_corpus.txt'i SINIRLI BELLEKLE akıtır,
// her kaydı hash'li torba-kelimelerine çevirir ve SEL blokunu online eğitir.
// Veri kümesi hiçbir zaman tamamen RAM'e yüklenmez; tepe bellek kullanımı
// parça+kayıt+tekilleştirme tamponlarıyla sabittir (raporda VmHWM ile ölçülür).
//
// Çalıştırma (repo kökünden):
//   ./zig-out/bin/lir run ai/gen_stream_corpus.lir --backend=native
//   ./zig-out/bin/lir run ai/train_stream.lir --backend=native
import "src/stream.lir"
import "src/noema_text.lir"
import "src/ledger.lir"

const DIM: i64 = 256
const NCLASS: i64 = 4
const ETA: i64 = ONE / 32

/// /proc/self/status içinden VmHWM (tepe RSS) kB değerini döndürür; yoksa -1.
fn rss_hwm_kb() -> i64 {
    let fd = @open("/proc/self/status", 0, 0)
    if fd < 0 { return -1 }
    let buf = @malloc(16384)
    var total: i64 = 0
    var n = @read(fd, buf, 16384)
    while n > 0 and total + n <= 16384 {
        total = total + n
        if n < 16384 - total { break }
        n = @read(fd, @ptr_add(buf, total), 16384 - total)
    }
    @close(fd)
    var i: i64 = 0
    while i + 6 <= total {
        if @read_u8(@ptr_add(buf, i)) == 86 and @read_u8(@ptr_add(buf, i + 1)) == 109 and @read_u8(@ptr_add(buf, i + 2)) == 72 and @read_u8(@ptr_add(buf, i + 3)) == 87 and @read_u8(@ptr_add(buf, i + 4)) == 77 and @read_u8(@ptr_add(buf, i + 5)) == 58 {
            var j = i + 6
            while j < total and (@read_u8(@ptr_add(buf, j)) == 32 or @read_u8(@ptr_add(buf, j)) == 9) { j = j + 1 }
            var v: i64 = 0
            var digits: i64 = 0
            while j < total {
                let c = @read_u8(@ptr_add(buf, j)) as i64
                if c < 48 or c > 57 { break }
                v = v * 10 + (c - 48)
                digits = digits + 1
                j = j + 1
            }
            @free(buf)
            if digits == 0 { return -1 }
            return v
        }
        i = i + 1
    }
    @free(buf)
    return -1
}

/// Kaydın son satırı "label:<0-3>" olmalı; metin kısmı öncesidir.
/// Dönen: label (0..3) veya -1; return değeri üzerinden metin uzunluğu hesaplanır.
fn parse_label(rec: *u8, n: i64) -> i64 {
    var nl = n - 1
    var found: i64 = 0
    while nl >= 0 {
        if @read_u8(@ptr_add(rec, nl)) == 10 { found = 1 break }
        nl = nl - 1
    }
    if found == 0 { return -1 }
    let ls = nl + 1
    if n - ls != 7 { return -1 }
    if @read_u8(@ptr_add(rec, ls)) != 108 { return -1 } // l
    if @read_u8(@ptr_add(rec, ls + 1)) != 97 { return -1 } // a
    if @read_u8(@ptr_add(rec, ls + 2)) != 98 { return -1 } // b
    if @read_u8(@ptr_add(rec, ls + 3)) != 101 { return -1 } // e
    if @read_u8(@ptr_add(rec, ls + 4)) != 108 { return -1 } // l
    if @read_u8(@ptr_add(rec, ls + 5)) != 58 { return -1 } // :
    let d = @read_u8(@ptr_add(rec, ls + 6)) as i64
    if d < 48 or d > 51 { return -1 }
    // Label döndür, çağıran nl'yi kullanabilir (nl = metin uzunluğu)
    return d - 48
}

/// Tamsayıyı belleğe decimal olarak yazar; döndürür: yazılan bayt sayısı.
fn write_i64_dec(buf: *u8, value: i64) -> i64 {
    var n = value
    var len: i64 = 0
    if n == 0 { @write_u8(buf, 48 as u8) len = 1 }
    else {
        if n < 0 { @write_u8(buf, 45 as u8) len = 1 n = 0 - n }
        let start = len
        while n > 0 { @write_u8(@ptr_add(buf, len), (48 + (n % 10)) as u8) len = len + 1 n = n / 10 }
        var lo = start
        var hi = len - 1
        while lo < hi {
            let a = @read_u8(@ptr_add(buf, lo))
            let b = @read_u8(@ptr_add(buf, hi))
            @write_u8(@ptr_add(buf, lo), b)
            @write_u8(@ptr_add(buf, hi), a)
            lo = lo + 1
            hi = hi - 1
        }
    }
    return len
}

/// Satır yaz: \n ile sonlandırır, stdout'a.
fn writeln(buf: *u8, len: i64) {
    @write_u8(@ptr_add(buf, len), 10 as u8)
    @write(1, buf, len + 1)
}

fn main() -> i64 {
    let rss0 = rss_hwm_kb()
    let t0 = @time_ns()
    var r = StreamReader.open("ai/noema-training/stream_corpus.txt", 65536, 8192, 262144)
    if r.fd < 0 {
        println("OPEN_FAIL: ai/noema-training/stream_corpus.txt yok — önce ai/gen_stream_corpus.lir çalıştırın")
        return 1
    }
    let feat = @malloc(DIM * 8)
    let tgt = @malloc(NCLASS * 8)
    let model = block_new(DIM, NCLASS, 32, 1729)
    var idx: i64 = 0
    var train_n: i64 = 0
    var dev_n: i64 = 0
    var train_ok: i64 = 0
    var dev_ok: i64 = 0
    var parse_bad: i64 = 0
    var enc_bad: i64 = 0
    var n = r.next()
    while n > 0 {
        let label = parse_label(r.rec, n)
        if label < 0 {
            parse_bad = parse_bad + 1
        } else {
            // Son satır 'label:X' formatında, metin uzunluğu son LF'in konumu
            var nl = n - 1
            while nl >= 0 {
                if @read_u8(@ptr_add(r.rec, nl)) == 10 { break }
                nl = nl - 1
            }
            let text_len = nl
            let toks = noema_text_encode_prompt(text_len, r.rec, DIM, feat)
            if toks <= 0 {
                enc_bad = enc_bad + 1
            } else {
                var c: i64 = 0
                while c < NCLASS {
                    @write_u64(@ptr_add(tgt, c * 8), (if c == label { ONE } else { 0 }) as u64)
                    c = c + 1
                }
                forward(model, feat)
                var best: i64 = 0 - 9223372036854775807
                var pred: i64 = 0
                c = 0
                while c < NCLASS {
                    let s = @read_u64(@ptr_add(model.out, c * 8)) as i64
                    if s > best { best = s pred = c }
                    c = c + 1
                }
                if idx % 10 == 0 {
                    dev_n = dev_n + 1
                    if pred == label { dev_ok = dev_ok + 1 }
                } else {
                    train_n = train_n + 1
                    if pred == label { train_ok = train_ok + 1 }
                    learn(model, feat, tgt, ETA)
                }
                idx = idx + 1
            }
        }
        n = r.next()
    }
    let elapsed_ns = @time_ns() - t0
    let elapsed_ms = (elapsed_ns / 1000000) as i64
    let rss1 = rss_hwm_kb()
    r.free()
    let line = @malloc(512)
    var pos: i64 = 0
    let s1 = "SEL streaming TXT pipeline — sınırlı bellek eğitimi"
    var i: i64 = 0
    while i < s1.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s1.ptr, i))) i = i + 1 }
    pos = pos + s1.len
    writeln(line, pos)
    pos = 0
    let s2 = "kayıt yayınlanan/tekil: "
    i = 0
    while i < s2.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s2.ptr, i))) i = i + 1 }
    pos = pos + s2.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), r.records)
    writeln(line, pos)
    pos = 0
    let s3 = "atlanan: dup="
    i = 0
    while i < s3.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s3.ptr, i))) i = i + 1 }
    pos = pos + s3.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), r.dups)
    let s4 = " invalid="
    i = 0
    while i < s4.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s4.ptr, i))) i = i + 1 }
    pos = pos + s4.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), r.invalids)
    let s5 = " oversize="
    i = 0
    while i < s5.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s5.ptr, i))) i = i + 1 }
    pos = pos + s5.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), r.oversize)
    let s6 = " empty="
    i = 0
    while i < s6.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s6.ptr, i))) i = i + 1 }
    pos = pos + s6.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), r.empties)
    writeln(line, pos)
    pos = 0
    let s7 = "parse_bad="
    i = 0
    while i < s7.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s7.ptr, i))) i = i + 1 }
    pos = pos + s7.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), parse_bad)
    let s8 = " encode_bad="
    i = 0
    while i < s8.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s8.ptr, i))) i = i + 1 }
    pos = pos + s8.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), enc_bad)
    writeln(line, pos)
    pos = 0
    let s9 = "okunan bayt: "
    i = 0
    while i < s9.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s9.ptr, i))) i = i + 1 }
    pos = pos + s9.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), r.bytes_read)
    writeln(line, pos)
    pos = 0
    let s10 = "süre: "
    i = 0
    while i < s10.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s10.ptr, i))) i = i + 1 }
    pos = pos + s10.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), elapsed_ms)
    let s11 = " ms"
    i = 0
    while i < s11.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s11.ptr, i))) i = i + 1 }
    pos = pos + s11.len
    writeln(line, pos)
    if elapsed_ms > 0 {
        pos = 0
        let s12 = "hız: "
        i = 0
        while i < s12.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s12.ptr, i))) i = i + 1 }
        pos = pos + s12.len
        pos = pos + write_i64_dec(@ptr_add(line, pos), r.bytes_read * 1000 / elapsed_ms)
        let s13 = " KB/s, "
        i = 0
        while i < s13.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s13.ptr, i))) i = i + 1 }
        pos = pos + s13.len
        pos = pos + write_i64_dec(@ptr_add(line, pos), r.records * 1000 / elapsed_ms)
        let s14 = " kayıt/sn"
        i = 0
        while i < s14.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s14.ptr, i))) i = i + 1 }
        pos = pos + s14.len
        writeln(line, pos)
    }
    pos = 0
    let s15 = "eğitilen/değerlendirilen: "
    i = 0
    while i < s15.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s15.ptr, i))) i = i + 1 }
    pos = pos + s15.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), train_n)
    let s16 = "/"
    i = 0
    while i < s16.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s16.ptr, i))) i = i + 1 }
    pos = pos + s16.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), dev_n)
    writeln(line, pos)
    pos = 0
    let s17 = "doğruluk train/dev: "
    i = 0
    while i < s17.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s17.ptr, i))) i = i + 1 }
    pos = pos + s17.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), train_ok)
    let s18 = "/"
    i = 0
    while i < s18.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s18.ptr, i))) i = i + 1 }
    pos = pos + s18.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), train_n)
    let s19 = " ; "
    i = 0
    while i < s19.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s19.ptr, i))) i = i + 1 }
    pos = pos + s19.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), dev_ok)
    let s20 = "/"
    i = 0
    while i < s20.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s20.ptr, i))) i = i + 1 }
    pos = pos + s20.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), dev_n)
    writeln(line, pos)
    pos = 0
    let s21 = "VmHWM kB önce/sonra: "
    i = 0
    while i < s21.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s21.ptr, i))) i = i + 1 }
    pos = pos + s21.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), rss0)
    let s22 = " / "
    i = 0
    while i < s22.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s22.ptr, i))) i = i + 1 }
    pos = pos + s22.len
    pos = pos + write_i64_dec(@ptr_add(line, pos), rss1)
    writeln(line, pos)
    let s23 = "Bellek: chunk 64KiB + kayıt 8KiB + dedup 2MiB + model — veri boyutundan bağımsız."
    pos = 0
    i = 0
    while i < s23.len { @write_u8(@ptr_add(line, pos + i), @read_u8(@ptr_add(s23.ptr, i))) i = i + 1 }
    pos = pos + s23.len
    writeln(line, pos)
    @free(line)
    return 0
}
