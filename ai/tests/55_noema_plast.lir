// NOEMA-Φ Faz 4.3 testi: tekil plastisite yasası — K_kons=16
// konsolidasyonu (§7.3) ve altı-rejimli kapı + marj W_m (§7.4).
//
// Kapsam: W_m lojistiği, G_sürpriz clip'i, §10.1 marj atlaması,
// altı rejimin (G_kapi, W+, W-, μ_cawr) çözümü, geçersiz rejim reddi,
// 16 darbelik pencerede taban+kip güncellemesi (bağımsız elle-hesap),
// m_i<=0.01 kip atlaması, köprü Laplacian'ı, acc sıfırlanması,
// marj-atlaması yazım yolu, training=0 reddi, determinizm.
import "../src/noema_const.lir"
import "../src/noema_math.lir"
import "../src/noema_arena.lir"
import "../src/noema_arena_rt.lir"
import "../src/noema_atlas.lir"
import "../src/noema_metric.lir"
import "../src/noema_plast.lir"

fn q6(x: f64) -> i64 {
    return @floor(x * 1000000.0 + 0.5) as i64
}

fn main() -> i64 {
    var checks: i64 = 0
    var passed: i64 = 0
    var gate: [4]f64 = [0.0; 4]

    // ── Marj fonksiyonu W_m ──────────────────────────────────────────
    // F+−F− = 1.5 → x = (1.5+1.5)/0.25 = 12 → σ_l(12)
    let wm = plast_margin_wm(2.0, 0.5)
    checks = checks + 1
    if @fabs(wm - noema_logistic(12.0)) < 1e-12 { passed = passed + 1 }
    printInt(q6(wm)) println("")

    // ── G_sürpriz: clip((-ΔF − δ0)/F_ref, 0, 1) ─────────────────────
    checks = checks + 4
    if @fabs(plast_g_surpriz(0.0 - 3.0, 0.5, 4.0) - 0.625) < 1e-12 { passed = passed + 1 }
    if plast_g_surpriz(1.0, 0.5, 4.0) == 0.0 { passed = passed + 1 }
    if plast_g_surpriz(0.0 - 100.0, 0.5, 4.0) == 1.0 { passed = passed + 1 }
    if plast_g_surpriz(0.0 - 3.0, 0.5, 0.0) == 0.0 { passed = passed + 1 }
    printlnFloat(plast_g_surpriz(0.0 - 3.0, 0.5, 4.0))

    // ── §10.1 marj atlaması ─────────────────────────────────────────
    checks = checks + 2
    if plast_margin_skip(2.5, 0.5) == 1 { passed = passed + 1 }   // 2.0 > 1.875
    if plast_margin_skip(1.0, 0.5) == 0 { passed = passed + 1 }   // 0.5 <= 1.875

    // ── Altı rejim kapısı ───────────────────────────────────────────
    // wm=0.6, gs=0.3, gonay=0.001, ghata=0.002, mu_oz=0.6
    var rc: i64 = 0
    checks = checks + 1
    rc = plast_gate(REJIM_PRETRAIN, 0.6, 0.3, 0.001, 0.002, 0.6, &gate[0])
    if rc == 0 and @fabs(gate[0] - 0.3) < 1e-12 and gate[1] == 1.0 and gate[2] == 0.0 and gate[3] == 0.0 { passed = passed + 1 }
    rc = plast_gate(REJIM_DO_BOZULUM, 0.6, 0.3, 0.001, 0.002, 0.6, &gate[0])
    checks = checks + 1
    if rc == 0 and gate[0] == 0.3 and gate[1] == 0.6 and gate[2] == 0.6 and @fabs(gate[3] - NOEMA_MU_CAWR_DO) < 1e-12 { passed = passed + 1 }
    rc = plast_gate(REJIM_FT_TAM, 0.6, 0.3, 0.001, 0.002, 0.6, &gate[0])
    checks = checks + 1
    if rc == 0 and gate[0] == 1.0 and gate[1] == 0.6 and gate[3] == 0.6 { passed = passed + 1 }
    // wm=0.01 <= eps_m=0.02 → FT kapısı kapanır
    rc = plast_gate(REJIM_FT_TAM, 0.01, 0.3, 0.001, 0.002, 0.6, &gate[0])
    checks = checks + 1
    if rc == 0 and gate[0] == 0.0 { passed = passed + 1 }
    rc = plast_gate(REJIM_CIKARIM_BEKLEME, 0.6, 0.3, 0.001, 0.002, 0.6, &gate[0])
    checks = checks + 1
    if rc == 0 and gate[0] == 0.0 and gate[1] == 0.0 and gate[3] == 0.0 { passed = passed + 1 }
    rc = plast_gate(REJIM_CIKARIM_OK, 0.6, 0.3, 0.001, 0.002, 0.6, &gate[0])
    checks = checks + 1
    if rc == 0 and gate[0] == 0.001 and gate[1] == 1.0 and gate[2] == 0.0 { passed = passed + 1 }
    rc = plast_gate(REJIM_CIKARIM_ERROR, 0.6, 0.3, 0.001, 0.002, 0.6, &gate[0])
    checks = checks + 1
    if rc == 0 and gate[0] == 0.002 and gate[1] == 0.0 and gate[2] == 1.0 and @fabs(gate[3] - NOEMA_MU_CAWR_HATA) < 1e-12 { passed = passed + 1 }
    checks = checks + 1
    if plast_gate(9, 0.6, 0.3, 0.001, 0.002, 0.6, &gate[0]) == -1 { passed = passed + 1 }
    printInt(q6(gate[3])) println("")

    // ── Konsolidasyon kurulumu ──────────────────────────────────────
    var cfg = Arena.config_default()
    var a = Arena.init(cfg)
    // İki aktif kart; 0↔1 köprüsü κ=0.5 (Laplacian testi için)
    a.atlas_bridge_set(0, 1, 0.5, 0.0)
    // Kip basitksi: m0=0.5 (>0.01 etkin), m1=0.005 (etkin değil),
    // m2..m4 payları — set 2 (m1) atlanmalı.
    a.mode_w_set(0, 0.5)
    a.mode_w_set(1, 0.005)
    a.mode_w_set(2, 0.2)
    a.mode_w_set(3, 0.2)
    a.mode_w_set(4, 0.095)

    // Metrik başlangıçları
    a.metric_sigma_set(0, 0, 0.1)
    a.metric_sigma_set(0, 1, 0.04)
    a.metric_sigma_set(0, 2, 0.07)
    a.metric_sigma_set(1, 0, 0.3)
    a.metric_sigma_set(1, 1, 0.02)
    a.metric_u_set(0, 0, 0, 10, 0.1)
    a.metric_u_set(0, 0, 1, 5, 0.2)
    a.metric_u_set(0, 1, 0, 10, 0.05)
    a.metric_b_set(0, 0, 3, 0.2)
    a.metric_b_set(0, 1, 3, 0.1)

    // Birikimli akılar (16 darbe boyunca birikecek tek seferlik yazım)
    a.acc_sigma_add(0, 0, 2.0)
    a.acc_sigma_add(0, 1, 1.0)
    a.acc_sigma_add(0, 2, 5.0)      // etkin kip değil → kullanılmaz
    a.acc_sigma_add(1, 0, -1.0)
    a.acc_u_add(0, 0, 0, 10, 4.0)
    a.acc_u_add(0, 1, 0, 10, 2.0)
    a.acc_b_add(0, 0, 3, 0.5)
    a.acc_b_add(0, 1, 3, 0.25)

    // 15 darbe: pencere açık, konsolidasyon yok
    var t: i64 = 0
    var last: i64 = -9
    while t < NOEMA_K_KONS - 1 {
        last = a.plast_tick(2, 1)
        t = t + 1
    }
    checks = checks + 3
    if last == 0 { passed = passed + 1 }
    if a.plast_beat_get() == NOEMA_K_KONS - 1 { passed = passed + 1 }
    if a.metric_sigma_at(0, 0) == 0.1 { passed = passed + 1 }

    // 16. darbe: konsolidasyon
    last = a.plast_tick(2, 1)
    checks = checks + 1
    if last == 1 { passed = passed + 1 }
    printInt(last) println("")
    printInt(a.plast_beat_get()) println("")

    // Bağımsız beklentiler (§7.3 formülleri, elle hesap)
    // k=0,s=0: lap=0.5*(0.3-0.1)=0.1
    //   drv = 0.05*0.1 - 0.005*0.1 + 0.2*2.0 = 0.4045
    //   σ' = 0.1 + 1e-3*0.4045 = 0.1004045
    let e00 = 0.1 + NOEMA_ALPHA_SIGMA * (NOEMA_KAPPA_SIGMA_0 * 0.1 - NOEMA_KAPPA_0_0 * 0.1 + NOEMA_ETA_0 * 2.0)
    // k=0,s=1 (m0=0.5): lap=0.5*(0.02-0.04)=-0.01
    //   drv = 0.01*(-0.01) - 0.001*0.04 + 0.5*1.0 = 0.49986
    //   σ' = 0.04 + 5e-4*0.49986 = 0.04024993
    let e01 = 0.04 + NOEMA_ALPHA_SIGMA * (NOEMA_KAPPA_SIGMA_KIP * (0.0 - 0.01) - NOEMA_KAPPA_0_KIP * 0.04 + 0.5 * 1.0)
    // k=1,s=0: lap=0.5*(0.1-0.3)=-0.1
    //   drv = 0.05*(-0.1) - 0.005*0.3 + 0.2*(-1.0) = -0.2065
    //   σ' = 0.3 - 1e-3*0.2065 = 0.2997935
    let e10 = 0.3 + NOEMA_ALPHA_SIGMA * (NOEMA_KAPPA_SIGMA_0 * (0.0 - 0.1) - NOEMA_KAPPA_0_0 * 0.3 + NOEMA_ETA_0 * (0.0 - 1.0))
    // U k0s0(0,10): 0.1 + 5e-4*(0.2*4 - 0.025*0.1) = 0.10039875
    let eu00 = 0.1 + NOEMA_ALPHA_U * (NOEMA_ETA_0 * 4.0 - NOEMA_KAPPA_U_0 * 0.1)
    // U k0s0(1,5): acc=0 → yalnız sönüm: 0.2 - 5e-4*0.025*0.2
    let eu01 = 0.2 - NOEMA_ALPHA_U * NOEMA_KAPPA_U_0 * 0.2
    // U k0s1(0,10): 0.05 + 5e-4*(0.5*2 - 0.005*0.05) = 0.050499875
    let eu10 = 0.05 + NOEMA_ALPHA_U * (0.5 * 2.0 - NOEMA_KAPPA_U_KIP * 0.05)
    // b k0s0 d3: 0.2 + 8e-4*(0.2*0.5 - 0.025*0.2) = 0.200076
    let eb00 = 0.2 + NOEMA_ALPHA_B * (NOEMA_ETA_0 * 0.5 - NOEMA_KAPPA_B_0 * 0.2)
    // b k0s1 d3: 0.1 + 8e-4*(0.5*0.25 - 0.005*0.1) = 0.1000996
    let eb10 = 0.1 + NOEMA_ALPHA_B * (0.5 * 0.25 - NOEMA_KAPPA_B_KIP * 0.1)

    checks = checks + 9
    if @fabs(a.metric_sigma_at(0, 0) - e00) < 1e-9 { passed = passed + 1 }
    if @fabs(a.metric_sigma_at(0, 1) - e01) < 1e-9 { passed = passed + 1 }
    if @fabs(a.metric_sigma_at(0, 2) - 0.07) < 1e-12 { passed = passed + 1 }
    if @fabs(a.metric_sigma_at(1, 0) - e10) < 1e-9 { passed = passed + 1 }
    if @fabs(a.metric_u_at(0, 0, 0, 10) - eu00) < 1e-9 { passed = passed + 1 }
    if @fabs(a.metric_u_at(0, 0, 1, 5) - eu01) < 1e-9 { passed = passed + 1 }
    if @fabs(a.metric_u_at(0, 1, 0, 10) - eu10) < 1e-9 { passed = passed + 1 }
    if @fabs(a.metric_b_at(0, 0, 3) - eb00) < 1e-9 { passed = passed + 1 }
    if @fabs(a.metric_b_at(0, 1, 3) - eb10) < 1e-9 { passed = passed + 1 }
    printInt(q6(a.metric_sigma_at(0, 0))) println("")
    printInt(q6(a.metric_sigma_at(0, 1))) println("")
    printInt(q6(a.metric_sigma_at(1, 0))) println("")
    printInt(q6(a.metric_u_at(0, 0, 0, 10))) println("")
    printInt(q6(a.metric_b_at(0, 0, 3))) println("")

    // acc tamponları tüketildi → sıfır
    checks = checks + 2
    if a.acc_sigma_at(0, 0) == 0.0 and a.acc_sigma_at(1, 0) == 0.0 { passed = passed + 1 }
    if a.acc_u_at(0, 0, 0, 10) == 0.0 and a.acc_b_at(0, 0, 3) == 0.0 { passed = passed + 1 }

    // ── Marj atlaması: yazım yok, tamponlar yine sıfırlanır ─────────
    let s_before = a.metric_sigma_at(0, 0)
    a.acc_sigma_add(0, 0, 3.0)
    a.acc_u_add(0, 0, 0, 10, 1.0)
    t = 0
    while t < NOEMA_K_KONS { a.plast_tick(2, 0) t = t + 1 }
    checks = checks + 2
    if a.metric_sigma_at(0, 0) == s_before { passed = passed + 1 }
    if a.acc_sigma_at(0, 0) == 0.0 and a.acc_u_at(0, 0, 0, 10) == 0.0 { passed = passed + 1 }
    printInt(a.plast_beat_get()) println("")

    // ── Argüman hataları ────────────────────────────────────────────
    checks = checks + 2
    if a.plast_consolidate(0, 1) == -2 { passed = passed + 1 }
    if a.plast_consolidate(5, 1) == -2 { passed = passed + 1 }

    a.free()

    // training=0 → plast_* reddedilir (acc pointerları hayalet
    // bölgede; plast_ok öncesi dokunulmaz)
    var cfg2 = Arena.config_default()
    cfg2.training = 0
    var a2 = Arena.init(cfg2)
    checks = checks + 1
    if a2.plast_tick(2, 1) == -1 { passed = passed + 1 }
    a2.free()

    printInt(passed)
    print("/")
    printInt(checks)
    println("")
    return 0
}
