// Process Execution
// ════════════════════════════════════════════════════════════════════════════

struct ProcessResult {
    exit_code: i32
    stdout: string
    stderr: string
}

fn execCommand(cmd: string) -> ProcessResult {
    // Use fork + exec via syscalls
    // For now, simplified: write command to a temp file and use system()
    ProcessResult {
        exit_code: -1
        stdout: string { ptr: "", len: 0 }
        stderr: string { ptr: "exec not implemented", len: 20 }
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Platform Detection
// ════════════════════════════════════════════════════════════════════════════

enum Platform {
    Linux
    MacOS
    Windows
    Unknown
}

enum Arch {
    X86_64
    AArch64
    Riscv64
    Wasm32
    Unknown
}

struct PlatformInfo {
    os: Platform
    arch: Arch
    name: string
}

fn detectPlatform() -> PlatformInfo {
    // Try reading /proc/version for Linux detection
    let file = File.open("/proc/version", FileMode.Read)
    if file.isOk() {
        let f = file.unwrap()
        f.close()
        return PlatformInfo {
            os: Platform.Linux
            arch: Arch.X86_64  // assume x86_64 for now
            name: "linux"
        }
    }

    PlatformInfo {
        os: Platform.Unknown
        arch: Arch.Unknown
        name: "unknown"
    }
}

fn platformName(p: Platform) -> string {
    match p {
        Platform.Linux => "linux"
        Platform.MacOS => "macos"
        Platform.Windows => "windows"
        Platform.Unknown => "unknown"
    }
}

fn archName(a: Arch) -> string {
    match a {
        Arch.X86_64 => "x86_64"
        Arch.AArch64 => "aarch64"
        Arch.Riscv64 => "riscv64"
        Arch.Wasm32 => "wasm32"
        Arch.Unknown => "unknown"
    }
}
