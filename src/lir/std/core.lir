// Lir Core Standard Library
// Comprehensive runtime for self-hosting compiler and applications
// Provides: types, collections, string ops, math, IO, error handling,
//           memory management, sorting, searching, iteration, and more.

// ════════════════════════════════════════════════════════════════════════════
// Primitive Types
// ════════════════════════════════════════════════════════════════════════════

type i8 = i8
type i16 = i16
type i32 = i32
type i64 = i64
type i128 = i128
type u8 = u8
type u16 = u16
type u32 = u32
type u64 = u64
type u128 = u128
type f16 = f16
type f32 = f32
type f64 = f64
type f128 = f128
type bool = bool
type void = void
type string = string
type char = char
type byte = u8
type usize = u64
type isize = i64
type any = *anyopaque
type never = !  // never type (for panic, etc.)

// ════════════════════════════════════════════════════════════════════════════
// Collections — Slice
// ════════════════════════════════════════════════════════════════════════════

struct Slice(T) {
    ptr: *T
    len: u64

    fn get(self: Slice(T), index: u64) -> ?T {
        if index >= self.len { null } else { self.ptr[index] }
    }

    fn set(self: *Slice(T), index: u64, value: T) -> bool {
        if index >= self.len { false } else { self.ptr[index] = value; true }
    }

    fn first(self: Slice(T)) -> ?T {
        if self.len == 0 { null } else { self.ptr[0] }
    }

    fn last(self: Slice(T)) -> ?T {
        if self.len == 0 { null } else { self.ptr[self.len - 1] }
    }

    fn sub(self: Slice(T), start: u64, end: u64) -> Slice(T) {
        if start > end or end > self.len {
            Slice(T) { ptr: null, len: 0 }
        } else {
            Slice(T) { ptr: &self.ptr[start], len: end - start }
        }
    }

    fn contains(self: Slice(T), value: T) -> bool {
        var i: u64 = 0
        while i < self.len {
            if self.ptr[i] == value { return true }
            i += 1
        }
        false
    }

    fn indexOf(self: Slice(T), value: T) -> ?u64 {
        var i: u64 = 0
        while i < self.len {
            if self.ptr[i] == value { return i }
            i += 1
        }
        null
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Collections — Fixed Array
// ════════════════════════════════════════════════════════════════════════════

struct Array(T, comptime N: u64) {
    data: [N]T

    fn get(self: *Array(T, N), index: u64) -> ?T {
        if index >= N { null } else { self.data[index] }
    }

    fn set(self: *Array(T, N), index: u64, value: T) -> bool {
        if index >= N { false } else { self.data[index] = value; true }
    }

    fn len(self: *Array(T, N)) -> u64 {
        N
    }

    fn fill(self: *Array(T, N), value: T) {
        var i: u64 = 0
        while i < N {
            self.data[i] = value
            i += 1
        }
    }

    fn toSlice(self: *Array(T, N)) -> Slice(T) {
        Slice(T) { ptr: &self.data, len: N }
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Collections — Dynamic Array (ArrayList)
// ════════════════════════════════════════════════════════════════════════════

struct ArrayList(T) {
    items: Slice(T)
    capacity: u64
    allocator: *Allocator

    fn init(alloc: *Allocator) -> ArrayList(T) {
        ArrayList(T) {
            items: Slice(T) { ptr: null, len: 0 }
            capacity: 0
            allocator: alloc
        }
    }

    fn len(self: *ArrayList(T)) -> u64 {
        self.items.len
    }

    fn isEmpty(self: *ArrayList(T)) -> bool {
        self.items.len == 0
    }

    fn capacity(self: *ArrayList(T)) -> u64 {
        self.capacity
    }

    fn push(self: *ArrayList(T), value: T) -> bool {
        if self.items.len >= self.capacity {
            let new_cap = if self.capacity == 0 { 8 } else { self.capacity * 2 }
            let new_ptr = self.allocator.realloc(self.items.ptr, new_cap * @size_of(T))
            if new_ptr == null { return false }
            self.items.ptr = new_ptr as *T
            self.capacity = new_cap
        }
        self.items.ptr[self.items.len] = value
        self.items.len += 1
        true
    }

    fn pushMany(self: *ArrayList(T), values: []T) -> bool {
        for values {
            if !self.push(it) { return false }
        }
        true
    }

    fn pop(self: *ArrayList(T)) -> ?T {
        if self.items.len == 0 { null }
        else {
            self.items.len -= 1
            self.items.ptr[self.items.len]
        }
    }

    fn get(self: *ArrayList(T), index: u64) -> ?T {
        if index >= self.items.len { null } else { self.items.ptr[index] }
    }

    fn set(self: *ArrayList(T), index: u64, value: T) -> bool {
        if index >= self.items.len { false } else { self.items.ptr[index] = value; true }
    }

    fn insert(self: *ArrayList(T), index: u64, value: T) -> bool {
        if index > self.items.len { return false }
        if self.items.len >= self.capacity {
            let new_cap = if self.capacity == 0 { 8 } else { self.capacity * 2 }
            let new_ptr = self.allocator.realloc(self.items.ptr, new_cap * @size_of(T))
            if new_ptr == null { return false }
            self.items.ptr = new_ptr as *T
            self.capacity = new_cap
        }
        // Shift elements right
        var i = self.items.len
        while i > index {
            self.items.ptr[i] = self.items.ptr[i - 1]
            i -= 1
        }
        self.items.ptr[index] = value
        self.items.len += 1
        true
    }

    fn remove(self: *ArrayList(T), index: u64) -> ?T {
        if index >= self.items.len { null }
        else {
            let val = self.items.ptr[index]
            // Shift elements left
            var i = index
            while i < self.items.len - 1 {
                self.items.ptr[i] = self.items.ptr[i + 1]
                i += 1
            }
            self.items.len -= 1
            val
        }
    }

    fn clear(self: *ArrayList(T)) {
        self.items.len = 0
    }

    fn slice(self: *ArrayList(T)) -> Slice(T) {
        self.items
    }

    fn first(self: *ArrayList(T)) -> ?T {
        self.items.first()
    }

    fn last(self: *ArrayList(T)) -> ?T {
        self.items.last()
    }

    fn contains(self: *ArrayList(T), value: T) -> bool {
        self.items.contains(value)
    }

    fn indexOf(self: *ArrayList(T), value: T) -> ?u64 {
        self.items.indexOf(value)
    }

    // Sort with comparator
    fn sort(self: *ArrayList(T), cmp: fn(*T, *T) -> i32) {
        // Quick sort implementation
        if self.items.len <= 1 { return }
        self.quickSort(0, self.items.len - 1, cmp)
    }

    fn quickSort(self: *ArrayList(T), lo: u64, hi: u64, cmp: fn(*T, *T) -> i32) {
        if lo >= hi { return }
        let pivot_idx = self.partition(lo, hi, cmp)
        if pivot_idx > 0 { self.quickSort(lo, pivot_idx - 1, cmp) }
        self.quickSort(pivot_idx + 1, hi, cmp)
    }

    fn partition(self: *ArrayList(T), lo: u64, hi: u64, cmp: fn(*T, *T) -> i32) -> u64 {
        let pivot = self.items.ptr[hi]
        var i = lo
        var j = lo
        while j < hi {
            if cmp(&self.items.ptr[j], &pivot) < 0 {
                let tmp = self.items.ptr[i]
                self.items.ptr[i] = self.items.ptr[j]
                self.items.ptr[j] = tmp
                i += 1
            }
            j += 1
        }
        let tmp = self.items.ptr[i]
        self.items.ptr[i] = self.items.ptr[hi]
        self.items.ptr[hi] = tmp
        i
    }

    // Binary search (requires sorted array)
    fn binarySearch(self: *ArrayList(T), value: *T, cmp: fn(*T, *T) -> i32) -> ?u64 {
        var lo: u64 = 0
        var hi = self.items.len
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            let c = cmp(value, &self.items.ptr[mid])
            if c == 0 { return mid }
            elif c < 0 { hi = mid }
            else { lo = mid + 1 }
        }
        null
    }

    // Reverse
    fn reverse(self: *ArrayList(T)) {
        var i: u64 = 0
        var j = self.items.len
        if j == 0 { return }
        j -= 1
        while i < j {
            let tmp = self.items.ptr[i]
            self.items.ptr[i] = self.items.ptr[j]
            self.items.ptr[j] = tmp
            i += 1
            j -= 1
        }
    }

    // Swap
    fn swap(self: *ArrayList(T), i: u64, j: u64) {
        if i >= self.items.len or j >= self.items.len { return }
        let tmp = self.items.ptr[i]
        self.items.ptr[i] = self.items.ptr[j]
        self.items.ptr[j] = tmp
    }

    // Map: transform each element
    fn map(self: *ArrayList(T), transform: fn(T) -> T) {
        var i: u64 = 0
        while i < self.items.len {
            self.items.ptr[i] = transform(self.items.ptr[i])
            i += 1
        }
    }

    // Filter: keep elements matching predicate
    fn filter(self: *ArrayList(T), predicate: fn(*T) -> bool) {
        var write_idx: u64 = 0
        var i: u64 = 0
        while i < self.items.len {
            if predicate(&self.items.ptr[i]) {
                self.items.ptr[write_idx] = self.items.ptr[i]
                write_idx += 1
            }
            i += 1
        }
        self.items.len = write_idx
    }

    // Reduce
    fn reduce(self: *ArrayList(T), init: T, reducer: fn(T, T) -> T) -> T {
        var acc = init
        var i: u64 = 0
        while i < self.items.len {
            acc = reducer(acc, self.items.ptr[i])
            i += 1
        }
        acc
    }

    // For each
    fn forEach(self: *ArrayList(T), callback: fn(*T)) {
        var i: u64 = 0
        while i < self.items.len {
            callback(&self.items.ptr[i])
            i += 1
        }
    }

    // Any: returns true if any element matches
    fn any(self: *ArrayList(T), predicate: fn(*T) -> bool) -> bool {
        var i: u64 = 0
        while i < self.items.len {
            if predicate(&self.items.ptr[i]) { return true }
            i += 1
        }
        false
    }

    // All: returns true if all elements match
    fn all(self: *ArrayList(T), predicate: fn(*T) -> bool) -> bool {
        var i: u64 = 0
        while i < self.items.len {
            if !predicate(&self.items.ptr[i]) { return false }
            i += 1
        }
        true
    }

    // Count: count elements matching predicate
    fn count(self: *ArrayList(T), predicate: fn(*T) -> bool) -> u64 {
        var c: u64 = 0
        var i: u64 = 0
        while i < self.items.len {
            if predicate(&self.items.ptr[i]) { c += 1 }
            i += 1
        }
        c
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Collections — HashMap
// ════════════════════════════════════════════════════════════════════════════

struct HashMapEntry(K, V) {
    key: K
    value: V
    occupied: bool
}

struct HashMap(K, V) {
    entries: ArrayList(HashMapEntry(K, V))
    size: u64
    allocator: *Allocator

    fn init(alloc: *Allocator) -> HashMap(K, V) {
        HashMap(K, V) {
            entries: ArrayList(HashMapEntry(K, V)).init(alloc)
            size: 0
            allocator: alloc
        }
    }

    fn len(self: *HashMap(K, V)) -> u64 {
        self.size
    }

    fn isEmpty(self: *HashMap(K, V)) -> bool {
        self.size == 0
    }

    // Simple hash for string keys (FNV-1a)
    fn hashStr(key: string) -> u64 {
        var hash: u64 = 14695981039346656037  // FNV offset basis
        var i: u64 = 0
        while i < key.len {
            hash = hash ^ (key.ptr[i] as u64)
            hash = hash * 1099511628211  // FNV prime
            i += 1
        }
        hash
    }

    // Simple hash for u64 keys
    fn hashU64(key: u64) -> u64 {
        var h = key
        h = h ^ (h >> 33)
        h = h * 0xff51afd7ed558ccd
        h = h ^ (h >> 33)
        h = h * 0xc4ceb9fe1a85ec53
        h = h ^ (h >> 33)
        h
    }

    fn findSlot(self: *HashMap(K, V), key: K) -> u64 {
        let cap = self.entries.len()
        if cap == 0 { return 0 }

        let hash = if K == string { HashMap.hashStr(key) } else { HashMap.hashU64(key as u64) }
        var idx = hash % cap
        var probe: u64 = 0

        while probe < cap {
            let slot = self.entries.get(idx)
            if slot == null or !slot.occupied {
                return idx
            }
            // Check key match
            if K == string {
                if strcmp(slot.key.ptr, key.ptr) == 0 { return idx }
            } elif slot.key == key {
                return idx
            }
            probe += 1
            idx = (idx + 1) % cap
        }
        idx
    }

    fn put(self: *HashMap(K, V), key: K, value: V) -> bool {
        // Resize if load factor > 0.75
        if self.size * 4 > self.entries.len() * 3 {
            if !self.resize() { return false }
        }

        let idx = self.findSlot(key)
        let existing = self.entries.get(idx)

        if existing != null and existing.occupied {
            // Update existing
            self.entries.ptr[idx].value = value
        } else {
            // Insert new
            self.entries.insert(idx, HashMapEntry(K, V) {
                key: key
                value: value
                occupied: true
            })
            self.size += 1
        }
        true
    }

    fn get(self: *HashMap(K, V), key: K) -> ?V {
        if self.entries.len() == 0 { return null }
        let idx = self.findSlot(key)
        let slot = self.entries.get(idx)
        if slot != null and slot.occupied { slot.value } else { null }
    }

    fn contains(self: *HashMap(K, V), key: K) -> bool {
        if self.entries.len() == 0 { return false }
        let idx = self.findSlot(key)
        let slot = self.entries.get(idx)
        slot != null and slot.occupied
    }

    fn remove(self: *HashMap(K, V), key: K) -> bool {
        if self.entries.len() == 0 { return false }
        let idx = self.findSlot(key)
        let slot = self.entries.get(idx)
        if slot != null and slot.occupied {
            self.entries.ptr[idx].occupied = false
            self.size -= 1
            true
        } else {
            false
        }
    }

    fn resize(self: *HashMap(K, V)) -> bool {
        let old_entries = self.entries.slice()
        let old_len = old_entries.len

        let new_cap = if old_len == 0 { 8 } else { old_len * 2 }
        self.entries = ArrayList(HashMapEntry(K, V)).init(self.allocator)
        self.size = 0

        var i: u64 = 0
        while i < old_len {
            let old = old_entries.ptr[i]
            if old.occupied {
                self.put(old.key, old.value)
            }
            i += 1
        }
        true
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Collections — HashSet
// ════════════════════════════════════════════════════════════════════════════

struct HashSetEntry(K) {
    key: K
    occupied: bool
}

struct HashSet(K) {
    entries: ArrayList(HashSetEntry(K))
    size: u64
    allocator: *Allocator

    fn init(alloc: *Allocator) -> HashSet(K) {
        HashSet(K) {
            entries: ArrayList(HashSetEntry(K)).init(alloc)
            size: 0
            allocator: alloc
        }
    }

    fn len(self: *HashSet(K)) -> u64 {
        self.size
    }

    fn isEmpty(self: *HashSet(K)) -> bool {
        self.size == 0
    }

    fn insert(self: *HashSet(K), key: K) -> bool {
        if self.size * 4 > self.entries.len() * 3 {
            self.resize()
        }

        let cap = self.entries.len()
        let hash = HashMap.hashU64(key as u64)
        var idx = hash % cap
        var probe: u64 = 0

        while probe < cap {
            let slot = self.entries.get(idx)
            if slot == null or !slot.occupied {
                self.entries.insert(idx, HashSetEntry(K) { key: key, occupied: true })
                self.size += 1
                return true
            }
            if slot.key == key {
                return false // already exists
            }
            probe += 1
            idx = (idx + 1) % cap
        }
        false
    }

    fn contains(self: *HashSet(K), key: K) -> bool {
        if self.entries.len() == 0 { return false }
        let cap = self.entries.len()
        let hash = HashMap.hashU64(key as u64)
        var idx = hash % cap
        var probe: u64 = 0

        while probe < cap {
            let slot = self.entries.get(idx)
            if slot == null or !slot.occupied { return false }
            if slot.key == key { return true }
            probe += 1
            idx = (idx + 1) % cap
        }
        false
    }

    fn remove(self: *HashSet(K), key: K) -> bool {
        if self.entries.len() == 0 { return false }
        let cap = self.entries.len()
        let hash = HashMap.hashU64(key as u64)
        var idx = hash % cap
        var probe: u64 = 0

        while probe < cap {
            let slot = self.entries.get(idx)
            if slot == null or !slot.occupied { return false }
            if slot.key == key {
                self.entries.ptr[idx].occupied = false
                self.size -= 1
                return true
            }
            probe += 1
            idx = (idx + 1) % cap
        }
        false
    }

    fn resize(self: *HashSet(K)) {
        let old_entries = self.entries.slice()
        let old_len = old_entries.len
        let new_cap = if old_len == 0 { 8 } else { old_len * 2 }
        self.entries = ArrayList(HashSetEntry(K)).init(self.allocator)
        self.size = 0

        var i: u64 = 0
        while i < old_len {
            let old = old_entries.ptr[i]
            if old.occupied {
                self.insert(old.key)
            }
            i += 1
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Collections — Stack
// ════════════════════════════════════════════════════════════════════════════

struct Stack(T) {
    items: ArrayList(T)

    fn init(alloc: *Allocator) -> Stack(T) {
        Stack(T) { items: ArrayList(T).init(alloc) }
    }

    fn push(self: *Stack(T), value: T) -> bool {
        self.items.push(value)
    }

    fn pop(self: *Stack(T)) -> ?T {
        self.items.pop()
    }

    fn peek(self: *Stack(T)) -> ?T {
        self.items.last()
    }

    fn isEmpty(self: *Stack(T)) -> bool {
        self.items.isEmpty()
    }

    fn len(self: *Stack(T)) -> u64 {
        self.items.len()
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Collections — Queue
// ════════════════════════════════════════════════════════════════════════════

struct Queue(T) {
    items: ArrayList(T)
    head: u64

    fn init(alloc: *Allocator) -> Queue(T) {
        Queue(T) { items: ArrayList(T).init(alloc), head: 0 }
    }

    fn enqueue(self: *Queue(T), value: T) -> bool {
        self.items.push(value)
    }

    fn dequeue(self: *Queue(T)) -> ?T {
        if self.head >= self.items.len() { return null }
        let val = self.items.get(self.head)
        self.head += 1
        // Compact when half is consumed
        if self.head > self.items.len() / 2 and self.head > 16 {
            self.compact()
        }
        val
    }

    fn peek(self: *Queue(T)) -> ?T {
        self.items.get(self.head)
    }

    fn len(self: *Queue(T)) -> u64 {
        self.items.len() - self.head
    }

    fn isEmpty(self: *Queue(T)) -> bool {
        self.len() == 0
    }

    fn compact(self: *Queue(T)) {
        // Shift elements to front
        var i: u64 = 0
        while i + self.head < self.items.len() {
            self.items.ptr[i] = self.items.ptr[i + self.head]
            i += 1
        }
        self.items.items.len -= self.head
        self.head = 0
    }
}

// ════════════════════════════════════════════════════════════════════════════
// String Operations
// ════════════════════════════════════════════════════════════════════════════

fn strlen(s: *u8) -> u64 {
    let len: u64 = 0
    while s[len] != 0 {
        len += 1
    }
    len
}

fn strcmp(a: *u8, b: *u8) -> i32 {
    let i: u64 = 0
    while a[i] != 0 and b[i] != 0 {
        if a[i] != b[i] {
            return a[i] as i32 - b[i] as i32
        }
        i += 1
    }
    a[i] as i32 - b[i] as i32
}

fn strncmp(a: *u8, b: *u8, n: u64) -> i32 {
    var i: u64 = 0
    while i < n and a[i] != 0 and b[i] != 0 {
        if a[i] != b[i] {
            return a[i] as i32 - b[i] as i32
        }
        i += 1
    }
    if i < n { a[i] as i32 - b[i] as i32 } else { 0 }
}

fn strcpy(dst: *u8, src: *u8) -> u64 {
    var i: u64 = 0
    while src[i] != 0 {
        dst[i] = src[i]
        i += 1
    }
    dst[i] = 0
    i
}

fn strcat(a: *u8, b: *u8, buf: *u8, buf_size: u64) -> u64 {
    let i: u64 = 0
    while a[i] != 0 and i < buf_size - 1 {
        buf[i] = a[i]
        i += 1
    }
    let j: u64 = 0
    while b[j] != 0 and i < buf_size - 1 {
        buf[i] = b[j]
        i += 1
        j += 1
    }
    buf[i] = 0
    i
}

fn strchr(s: *u8, ch: u8) -> ?*u8 {
    var i: u64 = 0
    while s[i] != 0 {
        if s[i] == ch { return &s[i] }
        i += 1
    }
    null
}

fn strrchr(s: *u8, ch: u8) -> ?*u8 {
    var last: ?*u8 = null
    var i: u64 = 0
    while s[i] != 0 {
        if s[i] == ch { last = &s[i] }
        i += 1
    }
    last
}

fn strstr(haystack: *u8, needle: *u8) -> ?*u8 {
    let needle_len = strlen(needle)
    if needle_len == 0 { return haystack }

    var i: u64 = 0
    while haystack[i] != 0 {
        var j: u64 = 0
        while j < needle_len and haystack[i + j] == needle[j] {
            j += 1
        }
        if j == needle_len { return &haystack[i] }
        i += 1
    }
    null
}

fn strContains(haystack: *u8, needle: *u8) -> bool {
    strstr(haystack, needle) != null
}

fn strStartsWith(s: *u8, prefix: *u8) -> bool {
    let prefix_len = strlen(prefix)
    var i: u64 = 0
    while i < prefix_len {
        if s[i] != prefix[i] { return false }
        i += 1
    }
    true
}

fn strEndsWith(s: *u8, suffix: *u8) -> bool {
    let s_len = strlen(s)
    let suffix_len = strlen(suffix)
    if suffix_len > s_len { return false }
    var i: u64 = 0
    while i < suffix_len {
        if s[s_len - suffix_len + i] != suffix[i] { return false }
        i += 1
    }
    true
}

fn strRepeat(s: *u8, count: u64, buf: *u8, buf_size: u64) -> u64 {
    let s_len = strlen(s)
    var pos: u64 = 0
    var rep: u64 = 0
    while rep < count and pos + s_len < buf_size {
        var i: u64 = 0
        while i < s_len {
            buf[pos] = s[i]
            pos += 1
            i += 1
        }
        rep += 1
    }
    buf[pos] = 0
    pos
}

fn strTrim(s: *u8, buf: *u8) -> u64 {
    var start: u64 = 0
    while s[start] == ' ' or s[start] == '\t' or s[start] == '\n' or s[start] == '\r' {
        start += 1
    }
    var end = strlen(s)
    while end > start and (s[end - 1] == ' ' or s[end - 1] == '\t' or s[end - 1] == '\n' or s[end - 1] == '\r') {
        end -= 1
    }
    var i: u64 = 0
    while start + i < end {
        buf[i] = s[start + i]
        i += 1
    }
    buf[i] = 0
    i
}

fn strToLower(s: *u8, buf: *u8) -> u64 {
    var i: u64 = 0
    while s[i] != 0 {
        if s[i] >= 'A' and s[i] <= 'Z' {
            buf[i] = s[i] + 32
        } else {
            buf[i] = s[i]
        }
        i += 1
    }
    buf[i] = 0
    i
}

fn strToUpper(s: *u8, buf: *u8) -> u64 {
    var i: u64 = 0
    while s[i] != 0 {
        if s[i] >= 'a' and s[i] <= 'z' {
            buf[i] = s[i] - 32
        } else {
            buf[i] = s[i]
        }
        i += 1
    }
    buf[i] = 0
    i
}

fn strCharAt(s: *u8, index: u64) -> ?u8 {
    let len = strlen(s)
    if index >= len { null } else { s[index] }
}

fn strSubStr(s: *u8, start: u64, end: u64, buf: *u8) -> u64 {
    let len = strlen(s)
    if start > end or end > len { return 0 }
    var i: u64 = 0
    while start + i < end {
        buf[i] = s[start + i]
        i += 1
    }
    buf[i] = 0
    i
}

fn strCharCount(s: *u8) -> u64 {
    var count: u64 = 0
    var i: u64 = 0
    while s[i] != 0 {
        // Count actual characters (not bytes) for ASCII
        count += 1
        i += 1
    }
    count
}

fn strReplace(s: *u8, from: *u8, to: *u8, buf: *u8, buf_size: u64) -> u64 {
    let s_len = strlen(s)
    let from_len = strlen(from)
    let to_len = strlen(to)

    if from_len == 0 {
        // Just copy
        var i: u64 = 0
        while i < s_len and i < buf_size - 1 {
            buf[i] = s[i]
            i += 1
        }
        buf[i] = 0
        return i
    }

    var pos: u64 = 0
    var buf_pos: u64 = 0
    while pos < s_len and buf_pos < buf_size - 1 {
        // Check if 'from' matches at current position
        var match = true
        var j: u64 = 0
        while j < from_len and pos + j < s_len {
            if s[pos + j] != from[j] { match = false; break }
            j += 1
        }

        if match and j == from_len {
            // Replace
            var k: u64 = 0
            while k < to_len and buf_pos < buf_size - 1 {
                buf[buf_pos] = to[k]
                buf_pos += 1
                k += 1
            }
            pos += from_len
        } else {
            buf[buf_pos] = s[pos]
            buf_pos += 1
            pos += 1
        }
    }
    buf[buf_pos] = 0
    buf_pos
}

// String to integer conversion
fn atoi(s: *u8) -> i64 {
    var result: i64 = 0
    var i: u64 = 0
    let neg = s[0] == '-'
    if neg { i = 1 }
    while s[i] != 0 and s[i] >= '0' and s[i] <= '9' {
        result = result * 10 + (s[i] - '0') as i64
        i += 1
    }
    if neg { -result } else { result }
}

// String to float conversion (simplified)
fn atof(s: *u8) -> f64 {
    var result: f64 = 0.0
    var i: u64 = 0
    let neg = s[0] == '-'
    if neg { i = 1 }

    // Integer part
    while s[i] != 0 and s[i] >= '0' and s[i] <= '9' {
        result = result * 10.0 + (s[i] - '0') as f64
        i += 1
    }

    // Fractional part
    if s[i] == '.' {
        i += 1
        var frac: f64 = 0.0
        var divisor: f64 = 10.0
        while s[i] != 0 and s[i] >= '0' and s[i] <= '9' {
            frac = frac + (s[i] - '0') as f64 / divisor
            divisor *= 10.0
            i += 1
        }
        result = result + frac
    }

    if neg { -result } else { result }
}

// ════════════════════════════════════════════════════════════════════════════
// Number to String Conversion
// ════════════════════════════════════════════════════════════════════════════

fn itoa(value: i64, buf: *u8, buf_size: u64) -> u64 {
    if value == 0 {
        buf[0] = '0'
        buf[1] = 0
        return 1
    }
    var v = value
    var i: u64 = 0
    let neg = v < 0
    if neg { v = -v }
    while v > 0 and i < buf_size - 1 {
        buf[buf_size - 2 - i] = (v % 10 + '0') as u8
        v /= 10
        i += 1
    }
    if neg {
        buf[buf_size - 2 - i] = '-'
        i += 1
    }
    // Reverse
    let start = buf_size - 1 - i
    let end = buf_size - 2
    var a = start
    var b = end
    while a < b {
        let tmp = buf[a]
        buf[a] = buf[b]
        buf[b] = tmp
        a += 1
        b -= 1
    }
    buf[buf_size - 1] = 0
    i
}

fn utoa(value: u64, buf: *u8, buf_size: u64) -> u64 {
    if value == 0 {
        buf[0] = '0'
        buf[1] = 0
        return 1
    }
    var v = value
    var i: u64 = 0
    while v > 0 and i < buf_size - 1 {
        buf[buf_size - 2 - i] = (v % 10 + '0') as u8
        v /= 10
        i += 1
    }
    let start = buf_size - 1 - i
    let end = buf_size - 2
    var a = start
    var b = end
    while a < b {
        let tmp = buf[a]
        buf[a] = buf[b]
        buf[b] = tmp
        a += 1
        b -= 1
    }
    buf[buf_size - 1] = 0
    i
}

fn ftoa(value: f64, buf: *u8, buf_size: u64, precision: u32) -> u64 {
    if value == 0.0 {
        buf[0] = '0'
        buf[1] = '.'
        var p: u64 = 0
        while p < precision and p + 2 < buf_size {
            buf[2 + p] = '0'
            p += 1
        }
        buf[2 + p] = 0
        return 2 + p
    }

    var pos: u64 = 0
    var v = value

    if v < 0.0 {
        buf[pos] = '-'
        pos += 1
        v = -v
    }

    // Integer part
    let int_part = v as u64
    pos += itoa(int_part as i64, &buf[pos], buf_size - pos)

    // Decimal point
    if pos < buf_size - 1 {
        buf[pos] = '.'
        pos += 1
    }

    // Fractional part
    var frac = v - int_part as f64
    var p: u32 = 0
    while p < precision and pos < buf_size - 1 {
        frac *= 10.0
        let digit = frac as u32
        buf[pos] = (digit + '0') as u8
        pos += 1
        frac -= digit as f64
        p += 1
    }

    buf[pos] = 0
    pos
}

// ════════════════════════════════════════════════════════════════════════════
// Memory Allocation
// ════════════════════════════════════════════════════════════════════════════

struct Allocator {
    brk_start: u64
    brk_current: u64
    brk_end: u64
    total_allocated: u64
    alloc_count: u64
}

fn allocator_init() -> Allocator {
    let current = syscall_brk(0)
    Allocator {
        brk_start: current
        brk_current: current
        brk_end: current + 1024 * 1024  // 1MB initial
        total_allocated: 0
        alloc_count: 0
    }
}

fn allocator_alloc(self: *Allocator, size: u64) -> ?*anyopaque {
    let aligned = (size + 15) & ~15  // 16-byte alignment
    let new_current = self.brk_current + aligned
    if new_current > self.brk_end {
        // Extend heap by at least 1MB or requested size
        let extend = if aligned > 1024 * 1024 { aligned * 2 } else { 1024 * 1024 }
        let new_end = new_current + extend
        let result = syscall_brk(new_end)
        if result == 0 { return null }
        self.brk_end = new_end
    }
    let ptr = self.brk_current
    self.brk_current = new_current
    self.total_allocated += aligned
    self.alloc_count += 1
    ptr as *anyopaque
}

fn allocator_realloc(self: *Allocator, ptr: *anyopaque, new_size: u64) -> ?*anyopaque {
    // Simple bump allocator — can't actually realloc
    // Allocate new and copy (simplified)
    self.allocator_alloc(new_size)
}

fn allocator_free(self: *Allocator, ptr: *anyopaque, size: u64) {
    _ = self
    _ = ptr
    _ = size
    // Simple bump allocator: no free
}

fn allocator_stats(self: *Allocator) {
    print("Allocator stats:\n")
    print("  Total allocated: ")
    printInt(self.total_allocated as i64)
    print(" bytes\n")
    print("  Allocation count: ")
    printInt(self.alloc_count as i64)
    print("\n")
    print("  Current break: ")
    printInt(self.brk_current as i64)
    print("\n")
}

// ════════════════════════════════════════════════════════════════════════════
// IO Operations
// ════════════════════════════════════════════════════════════════════════════

fn print(msg: string) {
    syscall_write(1, msg.ptr, msg.len)
}

fn eprint(msg: string) {
    syscall_write(2, msg.ptr, msg.len)
}

fn println(msg: string) {
    print(msg)
    syscall_write(1, "\n", 1)
}

fn eprintln(msg: string) {
    eprint(msg)
    syscall_write(2, "\n", 1)
}

fn printInt(value: i64) {
    var buf: [32]u8
    let len = itoa(value, &buf, 32)
    syscall_write(1, &buf, len)
}

fn printUInt(value: u64) {
    var buf: [32]u8
    let len = utoa(value, &buf, 32)
    syscall_write(1, &buf, len)
}

fn printFloat(value: f64) {
    var buf: [64]u8
    let len = ftoa(value, &buf, 64, 6)
    syscall_write(1, &buf, len)
}

fn readInput(buf: *u8, max_len: u64) -> u64 {
    syscall_read(0, buf, max_len)
}

// ════════════════════════════════════════════════════════════════════════════
// Math — Integer Operations
// ════════════════════════════════════════════════════════════════════════════

fn abs(x: i64) -> i64 {
    if x < 0 { -x } else { x }
}

fn min(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn max(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn clamp(value: i64, lo: i64, hi: i64) -> i64 {
    min(max(value, lo), hi)
}

fn umin(a: u64, b: u64) -> u64 {
    if a < b { a } else { b }
}

fn umax(a: u64, b: u64) -> u64 {
    if a > b { a } else { b }
}

fn uclamp(value: u64, lo: u64, hi: u64) -> u64 {
    umin(umax(value, lo), hi)
}

fn pow(base: i64, exp: u32) -> i64 {
    if exp == 0 { return 1 }
    var result: i64 = base
    var i: u32 = 1
    while i < exp {
        result *= base
        i += 1
    }
    result
}

fn ipow(base: u64, exp: u32) -> u64 {
    if exp == 0 { return 1 }
    var result: u64 = base
    var i: u32 = 1
    while i < exp {
        result *= base
        i += 1
    }
    result
}

fn factorial(n: u64) -> u64 {
    if n <= 1 { return 1 }
    var result: u64 = 1
    var i: u64 = 2
    while i <= n {
        result *= i
        i += 1
    }
    result
}

fn gcd(a: u64, b: u64) -> u64 {
    var x = a
    var y = b
    while y != 0 {
        let temp = y
        y = x % y
        x = temp
    }
    x
}

fn lcm(a: u64, b: u64) -> u64 {
    if a == 0 or b == 0 { return 0 }
    (a / gcd(a, b)) * b
}

fn isqrt(n: u64) -> u64 {
    if n == 0 { return 0 }
    var x = n
    var y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    x
}

// ════════════════════════════════════════════════════════════════════════════
// Math — Float Operations
// ════════════════════════════════════════════════════════════════════════════

fn fabs(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn fmin(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn fmax(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn fsqrt(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    // Newton's method
    var guess = x / 2.0
    var i: u32 = 0
    while i < 50 {
        guess = (guess + x / guess) / 2.0
        i += 1
    }
    guess
}

fn fpow(base: f64, exp: i32) -> f64 {
    if exp == 0 { return 1.0 }
    let negative = exp < 0
    let abs_exp = if negative { (-exp) as u32 } else { exp as u32 }
    var result: f64 = 1.0
    var b = base
    var e = abs_exp
    while e > 0 {
        if e & 1 == 1 {
            result *= b
        }
        b *= b
        e >>= 1
    }
    if negative { 1.0 / result } else { result }
}

fn fmod(x: f64, y: f64) -> f64 {
    x - (x / y) as i64 as f64 * y
}

fn floor(x: f64) -> f64 {
    let i = x as i64
    if x < 0.0 and x != i as f64 { (i - 1) as f64 } else { i as f64 }
}

fn ceil(x: f64) -> f64 {
    let i = x as i64
    if x > 0.0 and x != i as f64 { (i + 1) as f64 } else { i as f64 }
}

fn round(x: f64) -> f64 {
    floor(x + 0.5)
}

// ════════════════════════════════════════════════════════════════════════════
// Math — Trigonometry (simplified)
// ════════════════════════════════════════════════════════════════════════════

fn sin(x: f64) -> f64 {
    // Taylor series approximation
    let normalized = fmod(x, 2.0 * 3.14159265358979)
    var result: f64 = normalized
    var term: f64 = normalized
    var i: u32 = 1
    while i < 12 {
        term *= -normalized * normalized / ((2 * i) as f64 * (2 * i + 1) as f64)
        result += term
        i += 1
    }
    result
}

fn cos(x: f64) -> f64 {
    sin(x + 3.14159265358979 / 2.0)
}

fn tan(x: f64) -> f64 {
    let c = cos(x)
    if fabs(c) < 1e-10 { return 0.0 } // avoid division by zero
    sin(x) / c
}

fn atan(x: f64) -> f64 {
    // Simple atan approximation
    var result: f64 = x
    var term: f64 = x
    var x2 = x * x
    var i: u32 = 1
    while i < 10 {
        term *= -x2
        result += term / (2 * i + 1) as f64
        i += 1
    }
    result
}

fn atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 { atan(y / x) }
    elif x < 0.0 and y >= 0.0 { atan(y / x) + 3.14159265358979 }
    elif x < 0.0 and y < 0.0 { atan(y / x) - 3.14159265358979 }
    elif x == 0.0 and y > 0.0 { 3.14159265358979 / 2.0 }
    elif x == 0.0 and y < 0.0 { -3.14159265358979 / 2.0 }
    else { 0.0 } // x == 0 and y == 0
}

const PI: f64 = 3.14159265358979
const E: f64 = 2.71828182845905
const TAU: f64 = 6.28318530717959

// ════════════════════════════════════════════════════════════════════════════
// Bit Operations
// ════════════════════════════════════════════════════════════════════════════

fn popcount(x: u64) -> u32 {
    var v = x
    var count: u32 = 0
    while v != 0 {
        count += 1
        v &= v - 1
    }
    count
}

fn clz(x: u64) -> u32 {
    if x == 0 { return 64 }
    var v = x
    var count: u32 = 0
    while (v & 0x8000000000000000) == 0 {
        count += 1
        v <<= 1
    }
    count
}

fn ctz(x: u64) -> u32 {
    if x == 0 { return 64 }
    var v = x
    var count: u32 = 0
    while (v & 1) == 0 {
        count += 1
        v >>= 1
    }
    count
}

fn isPow2(x: u64) -> bool {
    x != 0 and (x & (x - 1)) == 0
}

fn nextPow2(x: u64) -> u64 {
    if x == 0 { return 1 }
    var v = x - 1
    v |= v >> 1
    v |= v >> 2
    v |= v >> 4
    v |= v >> 8
    v |= v >> 16
    v |= v >> 32
    v + 1
}

// ════════════════════════════════════════════════════════════════════════════
// Error Handling
// ════════════════════════════════════════════════════════════════════════════

enum Result(T, E) {
    Ok(T)
    Err(E)
}

enum Option(T) {
    Some(T)
    None
}

fn panic(msg: string) -> ! {
    eprint("PANIC: ")
    eprint(msg)
    eprint("\n")
    syscall_exit(1)
}

fn unreachable_fn() -> ! {
    panic("unreachable")
}

fn todo_fn() -> ! {
    panic("not yet implemented")
}

// ════════════════════════════════════════════════════════════════════════════
// Linux Syscalls
// ════════════════════════════════════════════════════════════════════════════

fn syscall_write(fd: u64, buf: *u8, len: u64) -> u64 {
    asm {
        syscall
    }
}

fn syscall_read(fd: u64, buf: *u8, len: u64) -> u64 {
    asm {
        syscall
    }
}

fn syscall_exit(status: u64) -> ! {
    asm {
        syscall
    }
}

fn syscall_brk(addr: u64) -> u64 {
    asm {
        syscall
    }
}

fn syscall_open(path: *u8, flags: i64, mode: i64) -> i64 {
    asm {
        syscall
    }
}

fn syscall_close(fd: u64) -> u64 {
    asm {
        syscall
    }
}

fn syscall_mmap(addr: u64, length: u64, prot: u64, flags: u64, fd: u64, offset: u64) -> u64 {
    asm {
        syscall
    }
}

fn syscall_munmap(addr: u64, length: u64) -> u64 {
    asm {
        syscall
    }
}

fn syscall_time() -> u64 {
    // SYS_time = 201 on x86-64 Linux
    asm {
        syscall
    }
}

fn syscall_nanosleep(seconds: u64, nanoseconds: u64) -> u64 {
    // SYS_nanosleep = 35 on x86-64 Linux
    // Would need struct timespec on stack
    _ = seconds
    _ = nanoseconds
    0
}

// ════════════════════════════════════════════════════════════════════════════
// Assertion
// ════════════════════════════════════════════════════════════════════════════

fn assert(condition: bool, msg: string) {
    if !condition {
        panic(msg)
    }
}

fn assertEq(a: i64, b: i64) {
    if a != b {
        print("Assertion failed: ")
        printInt(a)
        print(" != ")
        printInt(b)
        panic("\n")
    }
}

fn assertEqStr(a: *u8, b: *u8) {
    if strcmp(a, b) != 0 {
        print("Assertion failed: strings not equal\n")
        panic("")
    }
}

fn assertRange(value: i64, lo: i64, hi: i64) {
    if value < lo or value > hi {
        print("Assertion failed: value out of range\n")
        panic("")
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Type Utilities
// ════════════════════════════════════════════════════════════════════════════

comptime fn sizeOf(comptime T: type) -> u64 {
    @size_of(T)
}

comptime fn alignOf(comptime T: type) -> u64 {
    @align_of(T)
}

comptime fn typeName(comptime T: type) -> string {
    @typeName(T)
}

// ════════════════════════════════════════════════════════════════════════════
// Iteration
// ════════════════════════════════════════════════════════════════════════════

fn range(start: u64, end: u64) -> RangeIterator {
    RangeIterator { current: start, end: end }
}

fn rangeStep(start: u64, end: u64, step: u64) -> RangeStepIterator {
    RangeStepIterator { current: start, end: end, step: step }
}

struct RangeIterator {
    current: u64
    end: u64

    fn next(self: *RangeIterator) -> ?u64 {
        if self.current < self.end {
            let val = self.current
            self.current += 1
            val
        } else {
            null
        }
    }

    fn reset(self: *RangeIterator, start: u64) {
        self.current = start
    }
}

struct RangeStepIterator {
    current: u64
    end: u64
    step: u64

    fn next(self: *RangeStepIterator) -> ?u64 {
        if self.current < self.end {
            let val = self.current
            self.current += self.step
            val
        } else {
            null
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Sorting Algorithms
// ════════════════════════════════════════════════════════════════════════════

// Quick sort on raw slice
fn sortSlice(T)(ptr: *T, len: u64, cmp: fn(*T, *T) -> i32) {
    if len <= 1 { return }
    quickSortSlice(ptr, 0, len - 1, cmp)
}

fn quickSortSlice(T)(ptr: *T, lo: u64, hi: u64, cmp: fn(*T, *T) -> i32) {
    if lo >= hi { return }
    let pivot = partitionSlice(ptr, lo, hi, cmp)
    if pivot > 0 { quickSortSlice(ptr, lo, pivot - 1, cmp) }
    quickSortSlice(ptr, pivot + 1, hi, cmp)
}

fn partitionSlice(T)(ptr: *T, lo: u64, hi: u64, cmp: fn(*T, *T) -> i32) -> u64 {
    let pivot_val = ptr[hi]
    var i = lo
    var j = lo
    while j < hi {
        if cmp(&ptr[j], &pivot_val) < 0 {
            let tmp = ptr[i]
            ptr[i] = ptr[j]
            ptr[j] = tmp
            i += 1
        }
        j += 1
    }
    let tmp = ptr[i]
    ptr[i] = ptr[hi]
    ptr[hi] = tmp
    i
}

// Insertion sort (good for small arrays)
fn insertionSort(T)(ptr: *T, len: u64, cmp: fn(*T, *T) -> i32) {
    var i: u64 = 1
    while i < len {
        let key = ptr[i]
        var j = i
        while j > 0 and cmp(&ptr[j - 1], &key) > 0 {
            ptr[j] = ptr[j - 1]
            j -= 1
        }
        ptr[j] = key
        i += 1
    }
}

// Merge sort on ArrayList
fn mergeSortArrayList(T)(list: *ArrayList(T), cmp: fn(*T, *T) -> i32) {
    if list.len() <= 1 { return }
    // Simplified: use quicksort via the list's sort method
    list.sort(cmp)
}

// ════════════════════════════════════════════════════════════════════════════
// Search Algorithms
// ════════════════════════════════════════════════════════════════════════════

// Linear search
fn linearSearch(T)(ptr: *T, len: u64, value: *T, cmp: fn(*T, *T) -> i32) -> ?u64 {
    var i: u64 = 0
    while i < len {
        if cmp(value, &ptr[i]) == 0 { return i }
        i += 1
    }
    null
}

// Binary search (requires sorted array)
fn binarySearch(T)(ptr: *T, len: u64, value: *T, cmp: fn(*T, *T) -> i32) -> ?u64 {
    var lo: u64 = 0
    var hi = len
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        let c = cmp(value, &ptr[mid])
        if c == 0 { return mid }
        elif c < 0 { hi = mid }
        else { lo = mid + 1 }
    }
    null
}

// ════════════════════════════════════════════════════════════════════════════
// Random Number Generator (xoshiro128**)
// ════════════════════════════════════════════════════════════════════════════

struct Rng {
    s0: u64
    s1: u64
    s2: u64
    s3: u64

    fn init(seed: u64) -> Rng {
        // SplitMix64 initialization
        var state = seed
        var s0 = mixSplitMix(&state)
        var s1 = mixSplitMix(&state)
        var s2 = mixSplitMix(&state)
        var s3 = mixSplitMix(&state)
        Rng { s0: s0, s1: s1, s2: s2, s3: s3 }
    }

    fn mixSplitMix(state: *u64) -> u64 {
        *state += 0x9E3779B97F4A7C15
        var z = *state
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
        z = (z ^ (z >> 27)) * 0x94D049BB133111EB
        z ^ (z >> 31)
    }

    fn next(self: *Rng) -> u64 {
        let result = rotl(self.s1 * 5, 7) * 9
        let t = self.s1 << 17
        self.s2 ^= self.s0
        self.s3 ^= self.s1
        self.s1 ^= self.s2
        self.s0 ^= self.s3
        self.s2 ^= t
        self.s3 = rotl(self.s3, 45)
        result
    }

    fn nextInt(self: *Rng, max: u64) -> u64 {
        self.next() % max
    }

    fn nextRange(self: *Rng, lo: u64, hi: u64) -> u64 {
        lo + self.next() % (hi - lo)
    }

    fn nextFloat(self: *Rng) -> f64 {
        (self.next() >> 11) as f64 / (1u64 << 53) as f64
    }

    fn rotl(x: u64, k: u32) -> u64 {
        (x << k) | (x >> (64 - k))
    }
}

// ════════════════════════════════════════════════════════════════════════════
// Hash Functions
// ════════════════════════════════════════════════════════════════════════════

fn fnv1a(data: *u8, len: u64) -> u64 {
    var hash: u64 = 14695981039346656037
    var i: u64 = 0
    while i < len {
        hash = hash ^ (data[i] as u64)
        hash = hash * 1099511628211
        i += 1
    }
    hash
}

fn murmur3(data: *u8, len: u64, seed: u32) -> u32 {
    var h = seed
    var i: u64 = 0
    while i + 4 <= len {
        var k: u32 = 0
        k |= (data[i] as u32)
        k |= (data[i + 1] as u32) << 8
        k |= (data[i + 2] as u32) << 16
        k |= (data[i + 3] as u32) << 24

        k = k * 0xcc9e2d51
        k = (k << 15) | (k >> 17)
        k = k * 0x1b873593

        h ^= k
        h = (h << 13) | (h >> 19)
        h = h * 5 + 0xe6546b64

        i += 4
    }

    // Tail
    var k: u32 = 0
    var tail: u64 = len & 3
    var j: u64 = 0
    while j < tail {
        k |= (data[i + j] as u32) << (j * 8)
        j += 1
    }
    if tail > 0 {
        k = k * 0xcc9e2d51
        k = (k << 15) | (k >> 17)
        k = k * 0x1b873593
        h ^= k
    }

    h ^= len as u32
    h ^= h >> 16
    h = h * 0x85ebca6b
    h ^= h >> 13
    h = h * 0xc2b2ae35
    h ^= h >> 16
    h
}

// ════════════════════════════════════════════════════════════════════════════
// Date/Time (simplified)
// ════════════════════════════════════════════════════════════════════════════

struct Timestamp {
    seconds: u64
    nanoseconds: u64
}

fn now() -> Timestamp {
    let secs = syscall_time()
    Timestamp { seconds: secs, nanoseconds: 0 }
}

fn timestampDiff(a: Timestamp, b: Timestamp) -> u64 {
    if a.seconds > b.seconds { a.seconds - b.seconds } else { b.seconds - a.seconds }
}

// ════════════════════════════════════════════════════════════════════════════
// Utility Macros / Built-in Helpers
// ════════════════════════════════════════════════════════════════════════════

// Built-in functions (documented for reference):
// print(x)           — write to stdout
// eprint(x)          — write to stderr
// println(x)         — write to stdout + newline
// len(x)             — length of array/slice/string
// push(x, item)      — append to array
// pop(x)             — remove last from array
// slice(x, a, b)     — sub-slice
// type_of(x)         — type of expression
// size_of(T)         — size of type in bytes
// assert(cond)       — assert condition
// assert(cond, msg)  — assert with message
// panic(msg)         — panic with message
// unreachable()      — mark unreachable code
// todo()             — mark unfinished code
// @size_of(T)        — comptime size
// @align_of(T)       — comptime alignment
// @type_id(T)        — comptime type ID
// @typeName(T)       — comptime type name
