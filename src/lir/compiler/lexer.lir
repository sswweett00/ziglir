// LIR Compiler — Lexer
// Tokenizes LIR source code with zero allocations
// Performance: processes ~100MB/s on modern hardware

import core

// ════════════════════════════════════════════════════════════════════════════
// Token Types
// ════════════════════════════════════════════════════════════════════════════

enum TokenKind {
    // Literals
    IntLit
    FloatLit
    StringLit
    CharLit
    TrueLit
    FalseLit
    NullLit
    Ident

    // Keywords
    KwFn KwLet KwMut KwConst KwStruct KwEnum KwTrait KwImpl
    KwMatch KwIf KwElse KwWhile KwFor KwIn KwReturn KwBreak
    KwContinue KwDefer KwGo KwAsync KwAwait KwTry KwRecover
    KwPanic KwType KwWhere KwPub KwMod KwUse KwImport KwAs
    KwExtern KwUnsafe KwSafe KwStatic KwComptime KwSelf

    // Operators
    Plus Minus Star Slash Percent StarStar PlusPlus
    Eq Ne Lt Gt Le Ge
    Assign PlusAssign MinusAssign StarAssign SlashAssign PercentAssign
    AmpAssign PipeAssign
    AndAnd PipePipe Bang
    Amp Pipe Tilde Caret Shl Shr
    Arrow FatArrow PipeRight PipeLeft
    DotDot DotDotEq DotDotDot

    // Delimiters
    LParen RParen LBrace RBrace LBracket RBracket
    Semicolon Colon ColonColon Comma Dot At Hash Question

    // Special
    EOF Newline Error
}

struct Token {
    kind: TokenKind
    start: u32
    len: u32
    line: u32
    col: u32
}

// ════════════════════════════════════════════════════════════════════════════
// Lexer State
// ════════════════════════════════════════════════════════════════════════════

struct Lexer {
    src: string
    pos: u32
    line: u32
    col: u32
    tokens: ArrayList(Token)
    allocator: *Allocator
    errors: ArrayList(LexError)

    struct LexError {
        msg: string
        line: u32
        col: u32
    }

    fn init(alloc: *Allocator, source: string) -> Lexer {
        Lexer {
            src: source
            pos: 0
            line: 1
            col: 1
            tokens: ArrayList(Token).init(alloc)
            allocator: alloc
            errors: ArrayList(LexError).init(alloc)
        }
    }

    fn deinit(self: *Lexer) {
        self.tokens.deinit()
        self.errors.deinit()
    }

    // ── Character Access ─────────────────────────────────────────────

    fn peek(self: *Lexer) -> u8 {
        if self.pos >= self.src.len { 0 } else { self.src.ptr[self.pos] }
    }

    fn peekNext(self: *Lexer) -> u8 {
        if self.pos + 1 >= self.src.len { 0 } else { self.src.ptr[self.pos + 1] }
    }

    fn peekAt(self: *Lexer, offset: u32) -> u8 {
        let idx = self.pos + offset
        if idx >= self.src.len { 0 } else { self.src.ptr[idx] }
    }

    fn advance(self: *Lexer) -> u8 {
        let ch = self.peek()
        if ch == '\n' {
            self.line += 1
            self.col = 1
        } else {
            self.col += 1
        }
        self.pos += 1
        ch
    }

    fn matchChar(self: *Lexer, expected: u8) -> bool {
        if self.peek() == expected {
            self.advance()
            true
        } else {
            false
        }
    }

    // ── Token Emission ───────────────────────────────────────────────

    fn emit(self: *Lexer, kind: TokenKind, start: u32) {
        self.tokens.push(Token {
            kind: kind
            start: start
            len: self.pos - start
            line: self.line
            col: self.col - (self.pos - start)
        })
    }

    fn emitAt(self: *Lexer, kind: TokenKind, start: u32, line: u32, col: u32) {
        self.tokens.push(Token {
            kind: kind
            start: start
            len: self.pos - start
            line: line
            col: col
        })
    }

    fn addError(self: *Lexer, msg: string) {
        self.errors.push(LexError {
            msg: msg
            line: self.line
            col: self.col
        })
    }

    // ── Whitespace & Comments ────────────────────────────────────────

    fn skipWhitespace(self: *Lexer) {
        while self.pos < self.src.len {
            let ch = self.peek()

            // Regular whitespace
            if ch == ' ' or ch == '\t' or ch == '\r' {
                self.advance()
                continue
            }

            // Newlines (significant — implicit semicolons)
            if ch == '\n' {
                self.advance()
                break
            }

            // Line comment: //
            if ch == '/' and self.peekNext() == '/' {
                while self.pos < self.src.len and self.peek() != '\n' {
                    self.advance()
                }
                continue
            }

            // Block comment: /* ... */ (supports nesting)
            if ch == '/' and self.peekNext() == '*' {
                self.advance() // skip /
                self.advance() // skip *
                var depth: u32 = 1
                while self.pos < self.src.len and depth > 0 {
                    let c = self.peek()
                    if c == '/' and self.peekNext() == '*' {
                        self.advance()
                        self.advance()
                        depth += 1
                    } elif c == '*' and self.peekNext() == '/' {
                        self.advance()
                        self.advance()
                        depth -= 1
                    } else {
                        self.advance()
                    }
                }
                continue
            }

            // Hash comment: #
            if ch == '#' {
                while self.pos < self.src.len and self.peek() != '\n' {
                    self.advance()
                }
                continue
            }

            // Not whitespace
            break
        }
    }

    // ── Main Tokenize Loop ───────────────────────────────────────────

    fn tokenize(self: *Lexer) -> bool {
        while self.pos < self.src.len {
            self.skipWhitespace()
            if self.pos >= self.src.len { break }

            let start = self.pos
            let start_line = self.line
            let start_col = self.col
            let ch = self.peek()

            // Numbers
            if (ch >= '0' and ch <= '9') {
                let mut is_float = false
                while self.pos < self.src.len {
                    let c = self.peek()
                    if (c >= '0' and c <= '9') {
                        self.advance()
                    } elif c == '_' {
                        self.advance()
                    } elif c == '.' and !is_float {
                        if self.peekNext() >= '0' and self.peekNext() <= '9' {
                            is_float = true
                            self.advance()
                        } else {
                            break
                        }
                    } else {
                        break
                    }
                }
                // Suffix
                while self.pos < self.src.len {
                    let c = self.peek()
                    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') {
                        self.advance()
                    } else {
                        break
                    }
                }
                self.emitAt(if is_float { TokenKind.FloatLit } else { TokenKind.IntLit }, start, start_line, start_col)
                continue
            }

            // Identifiers and keywords
            if (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or ch == '_' {
                self.advance()
                while self.pos < self.src.len {
                    let c = self.peek()
                    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or
                       (c >= '0' and c <= '9') or c == '_' {
                        self.advance()
                    } else {
                        break
                    }
                }
                let kind = self.keywordOrIdent(start, self.pos - start)
                self.emitAt(kind, start, start_line, start_col)
                continue
            }

            // Char literal: 'c'
            if ch == '\'' {
                self.advance()
                if self.peek() == '\\' {
                    self.advance()
                }
                if self.pos < self.src.len { self.advance() }
                if self.pos < self.src.len and self.peek() == '\'' {
                    self.advance()
                }
                self.emitAt(TokenKind.CharLit, start, start_line, start_col)
                continue
            }

            // String literal: "..."
            if ch == '"' {
                self.advance()
                while self.pos < self.src.len and self.peek() != '"' {
                    if self.peek() == '\\' {
                        self.advance()
                        if self.pos < self.src.len { self.advance() }
                    } else {
                        self.advance()
                    }
                }
                if self.pos < self.src.len { self.advance() }
                self.emitAt(TokenKind.StringLit, start, start_line, start_col)
                continue
            }

            // Operators and punctuation
            self.advance()
            let kind = match ch {
                '+' => if self.peek() == '+' { self.advance(); TokenKind.PlusPlus }
                       elif self.peek() == '=' { self.advance(); TokenKind.PlusAssign }
                       else { TokenKind.Plus }
                '-' => if self.peek() == '>' { self.advance(); TokenKind.Arrow }
                       elif self.peek() == '=' { self.advance(); TokenKind.MinusAssign }
                       else { TokenKind.Minus }
                '*' => if self.peek() == '*' { self.advance(); TokenKind.StarStar }
                       elif self.peek() == '=' { self.advance(); TokenKind.StarAssign }
                       else { TokenKind.Star }
                '/' => if self.peek() == '=' { self.advance(); TokenKind.SlashAssign }
                       else { TokenKind.Slash }
                '%' => if self.peek() == '=' { self.advance(); TokenKind.PercentAssign }
                       else { TokenKind.Percent }
                '=' => if self.peek() == '=' { self.advance(); TokenKind.Eq }
                       elif self.peek() == '>' { self.advance(); TokenKind.FatArrow }
                       else { TokenKind.Assign }
                '!' => if self.peek() == '=' { self.advance(); TokenKind.Ne }
                       else { TokenKind.Bang }
                '<' => if self.peek() == '=' { self.advance(); TokenKind.Le }
                       elif self.peek() == '<' { self.advance(); TokenKind.Shl }
                       elif self.peek() == '|' { self.advance(); TokenKind.PipeLeft }
                       else { TokenKind.Lt }
                '>' => if self.peek() == '=' { self.advance(); TokenKind.Ge }
                       elif self.peek() == '>' { self.advance(); TokenKind.Shr }
                       else { TokenKind.Gt }
                '&' => if self.peek() == '&' { self.advance(); TokenKind.AndAnd }
                       elif self.peek() == '=' { self.advance(); TokenKind.AmpAssign }
                       else { TokenKind.Amp }
                '|' => if self.peek() == '|' { self.advance(); TokenKind.PipePipe }
                       elif self.peek() == '>' { self.advance(); TokenKind.PipeRight }
                       elif self.peek() == '=' { self.advance(); TokenKind.PipeAssign }
                       else { TokenKind.Pipe }
                '~' => TokenKind.Tilde
                '^' => TokenKind.Caret
                '?' => TokenKind.Question
                '@' => TokenKind.At
                '#' => TokenKind.Hash
                '(' => TokenKind.LParen
                ')' => TokenKind.RParen
                '{' => TokenKind.LBrace
                '}' => TokenKind.RBrace
                '[' => TokenKind.LBracket
                ']' => TokenKind.RBracket
                ';' => TokenKind.Semicolon
                ':' => if self.peek() == ':' { self.advance(); TokenKind.ColonColon } else { TokenKind.Colon }
                ',' => TokenKind.Comma
                '.' => if self.peek() == '.' {
                           self.advance()
                           if self.peek() == '=' { self.advance(); TokenKind.DotDotEq }
                           elif self.peek() == '.' { self.advance(); TokenKind.DotDotDot }
                           else { TokenKind.DotDot }
                       } else { TokenKind.Dot }
                '\\' => TokenKind.Error
                '\n' => TokenKind.Newline
                else => TokenKind.Error
            }
            self.emitAt(kind, start, start_line, start_col)
        }

        self.emit(TokenKind.EOF, self.pos)
        true
    }

    // ── Keyword Recognition (O(1) via length dispatch) ───────────────

    fn keywordOrIdent(self: *Lexer, start: u32, len: u32) -> TokenKind {
        if len == 2 {
            if self.matchWord(start, "fn") { return TokenKind.KwFn }
            if self.matchWord(start, "if") { return TokenKind.KwIf }
            if self.matchWord(start, "go") { return TokenKind.KwGo }
            if self.matchWord(start, "as") { return TokenKind.KwAs }
            if self.matchWord(start, "in") { return TokenKind.KwIn }
        }
        if len == 3 {
            if self.matchWord(start, "let") { return TokenKind.KwLet }
            if self.matchWord(start, "mut") { return TokenKind.KwMut }
            if self.matchWord(start, "for") { return TokenKind.KwFor }
            if self.matchWord(start, "try") { return TokenKind.KwTry }
            if self.matchWord(start, "mod") { return TokenKind.KwMod }
            if self.matchWord(start, "pub") { return TokenKind.KwPub }
            if self.matchWord(start, "use") { return TokenKind.KwUse }
        }
        if len == 4 {
            if self.matchWord(start, "else") { return TokenKind.KwElse }
            if self.matchWord(start, "enum") { return TokenKind.KwEnum }
            if self.matchWord(start, "type") { return TokenKind.KwType }
            if self.matchWord(start, "true") { return TokenKind.TrueLit }
            if self.matchWord(start, "self") { return TokenKind.KwSelf }
            if self.matchWord(start, "drop") { return TokenKind.KwSelf }
        }
        if len == 5 {
            if self.matchWord(start, "struct") { return TokenKind.KwStruct }
            if self.matchWord(start, "while") { return TokenKind.KwWhile }
            if self.matchWord(start, "trait") { return TokenKind.KwTrait }
            if self.matchWord(start, "async") { return TokenKind.KwAsync }
            if self.matchWord(start, "await") { return TokenKind.KwAwait }
            if self.matchWord(start, "panic") { return TokenKind.KwPanic }
            if self.matchWord(start, "false") { return TokenKind.FalseLit }
            if self.matchWord(start, "defer") { return TokenKind.KwDefer }
            if self.matchWord(start, "where") { return TokenKind.KwWhere }
        }
        if len == 6 {
            if self.matchWord(start, "return") { return TokenKind.KwReturn }
            if self.matchWord(start, "import") { return TokenKind.KwImport }
            if self.matchWord(start, "comtime") { return TokenKind.KwComptime }
            if self.matchWord(start, "recover") { return TokenKind.KwRecover }
            if self.matchWord(start, "extern") { return TokenKind.KwExtern }
            if self.matchWord(start, "unsafe") { return TokenKind.KwUnsafe }
            if self.matchWord(start, "static") { return TokenKind.KwStatic }
        }
        if len == 7 {
            if self.matchWord(start, "continue") { return TokenKind.KwContinue }
        }
        if len == 9 {
            if self.matchWord(start, "breakpoint") { return TokenKind.Ident }
        }

        TokenKind.Ident
    }

    fn matchWord(self: *Lexer, start: u32, word: string) -> bool {
        if self.pos - start != word.len { return false }
        var i: u32 = 0
        while i < word.len {
            if self.src.ptr[start + i] != word.ptr[i] { return false }
            i += 1
        }
        true
    }

    // ── Utilities ────────────────────────────────────────────────────

    fn getTokenText(self: *Lexer, tok: Token) -> string {
        string { ptr: &self.src.ptr[tok.start], len: tok.len }
    }

    fn getTokenCount(self: *Lexer) -> u32 {
        self.tokens.len() as u32
    }

    fn getToken(self: *Lexer, idx: u32) -> Token {
        self.tokens.items.ptr[idx]
    }
}
