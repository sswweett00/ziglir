// Branch Simplification
// ════════════════════════════════════════════════════════════════════════════

// Simplifies known branches:
// if true { A } else { B } → A
// if false { A } else { B } → B
// if x == x { A } else { B } → A
// x > x → false
// x < x → false
// x == x → true

fn simplifyBranch(cond: *ASTNode, ast: *AST) -> ?*ASTNode {
    // Constant condition
    if cond.kind == NodeKind.BoolLiteral {
        return null // will be handled by constant folding
