fn fib(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    let mut i = 0
    let mut sum = 0
    while i < 10 {
        if i % 2 == 0 { sum += i }
        elif i > 7 { break }
        else { sum -= 1 }
        i += 1
    }
    printInt(sum)
    printInt(fib(10))
}
