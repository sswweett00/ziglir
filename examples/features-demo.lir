# LIR Features Demo

fn fib(n: i64) -> i64 {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn main() -> i64 {
    # Variables & Arithmetic
    let x = 42
    let y = 10
    printInt(x + y)
    printInt(x * y)

    # Control Flow
    let mut i = 0
    let mut acc = 0
    while i < 5 {
        acc += i
        i += 1
    }
    printInt(acc)

    # Functions
    printInt(fib(10))

    # Logical Operators
    let a = 10 > 5
    let b = 3 < 1
    let c = a and !b
    printInt(c)

    # Arrays
    let arr = @array_new(8, 8)
    @array_push(arr, 100)
    @array_push(arr, 200)
    @array_push(arr, 300)
    printInt(@array_len(arr))
    printInt(@array_get(arr, 0))
    printInt(@array_get(arr, 2))

    # Modulo
    printInt(17 % 5)

    # Comparison
    printInt(10 == 10)
    printInt(10 != 10)
    printInt(5 <= 5)
    printInt(5 >= 6)

    # String
    println("All features working!")

    0
}
