// ════════════════════════════════════════════════════════════════════════════
// LirPad — Pure Lir GUI Application
//
// Bu uygulama %100 Lir dilinde yazılmıştır. Hiçbir yabancı dil (Zig, C vb.)
// kullanılmamıştır. Doğrudan Linux sistem çağrıları üzerine kurulu Lir
// bootstrap derleyicisi ile statik ELF ikili dosyasına derlenir.
//
// Build:  ../../src/bootstrap/lir-bootstrap build main.lir -o lirpad
// Run:    ./lirpad
// ════════════════════════════════════════════════════════════════════════════

// ── Yardımcı çizim fonksiyonları ────────────────────────────────────────────

// n adet boşluk bas
fn sp(n: i32) {
    let i: i32 = 0
    while i < n {
        print(" ")
        i = i + 1
    }
}

// n adet yatay çizgi karakteri bas
fn hline(n: i32) {
    let i: i32 = 0
    while i < n {
        print("─")
        i = i + 1
    }
}

// n adet dolu blok bas (progress bar dolu kısım)
fn bar(n: i32) {
    let i: i32 = 0
    while i < n {
        print("█")
        i = i + 1
    }
}

// n adet boş blok bas (progress bar boş kısım)
fn shade(n: i32) {
    let i: i32 = 0
    while i < n {
        print("░")
        i = i + 1
    }
}

// ── Ana uygulama ────────────────────────────────────────────────────────────

fn main() {
    // Terminal GUI kurulumu: alternatif ekran buffer'a geç, ekranı temizle,
    // imleci gizle
    print("\x1b[?1049h\x1b[2J\x1b[H")
    print("\x1b[?25l")

    // ══ Pencere üst kenarı ══
    print("\x1b[38;5;61m╭")
