// All amounts are integer cents, annual rates are basis points (100 = 1%).
// Bounds: money <= 100000000, debt APR <= 3600, return <= 2000, months <= 360.
// Under these bounds intermediate products stay within signed 64-bit range.
fn monthly_interest(balance: i64, annual_bps: i64) -> i64 {
    if balance <= 0 { return 0 }
    return (balance * annual_bps + 60000) / 120000
}
fn actual_payment(balance: i64, requested: i64) -> i64 {
    if requested > balance { return balance }
    return requested
}
fn strict_uint(text: string, maximum: i64) -> i64 {
    let length = @string_len(text)
    if length == 0 or length > 9 { return -1 }
    let mut value = 0
    let mut i = 0
    while i < length {
        let digit = @string_char_at(text, i) - 48
        if digit < 0 or digit > 9 { return -1 }
        value = value * 10 + digit
        if value > maximum { return -1 }
        i += 1
    }
    return value
}
fn field(name: string, value: i64) {
    print("\"")
    print(name)
    print("\":")
    printInt(value)
}
fn project(income: i64, expense: i64, initial: i64, loan: i64, apr: i64, payment: i64, growth: i64, months: i64) {
    let mut savings = initial
    let mut debt = loan
    let mut interest_total = 0
    let mut paid_total = 0
    let mut debt_free = -1
    if debt == 0 { debt_free = 0 }
    let mut lowest_cash = income - expense
    let mut m = 1
    print("{\"schema\":1,\"series\":[")
    while m <= months {
        let interest = monthly_interest(debt, apr)
        debt += interest
        let paid = actual_payment(debt, payment)
        debt -= paid
        let cash = income - expense - paid
        savings += monthly_interest(savings, growth) + cash
        interest_total += interest
        paid_total += paid
        if cash < lowest_cash { lowest_cash = cash }
        if debt == 0 and debt_free < 0 { debt_free = m }
        if m > 1 { print(",") }
        print("{")
        field("month", m)
        print(",")
        field("assets", savings)
        print(",")
        field("debt", debt)
        print(",")
        field("net", savings - debt)
        print(",")
        field("cash", cash)
        print("}")
        m += 1
    }
    print("],\"summary\":{")
    field("assets", savings)
    print(",")
    field("debt", debt)
    print(",")
    field("net", savings - debt)
    print(",")
    field("interest", interest_total)
    print(",")
    field("paid", paid_total)
    print(",")
    field("debtFreeMonth", debt_free)
    print(",")
    field("lowestCash", lowest_cash)
    println("}}")
}
